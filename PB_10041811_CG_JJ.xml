                  <castItem><role>Domesticks,</role> Mess. <actor ref="namedentities.xml#mr_brown">Brown,</actor> <actor ref="namedentities.xml#mr_grant">Grant,</actor> <actor ref="namedentities.xml#mr_heath">Heath,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor ref="namedentities.xml#mr_sarjant">Sarjant,</actor> <actor ref="namedentities.xml#mr_yarnold">Yarnold,</actor> &amp;c.</castItem><lb/>
                  <castItem><role>Countess of Lindenbergh (step-mother to Agnes)</role> <actor ref="namedentities.xml#mrs_kniveton">Mrs. <hi rend="allcaps">Kniveton</hi>,</actor></castItem><lb/>
