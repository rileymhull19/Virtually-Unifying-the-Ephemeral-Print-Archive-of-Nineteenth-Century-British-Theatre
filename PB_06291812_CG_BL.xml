                  <castItem><role>Apparitions,</role> <actor>Mr. Bishop,</actor> <actor>Miss S. Goodwin,</actor> <actor>Miss C. Goodwin.</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">The Choral Witches by</hi></role><lb/>
                     <hi rend="italic">Mess.</hi> <actor>Duruset,</actor> <actor>Everard,</actor> <actor>Hickman,</actor> <actor>Huckel,</actor> <actor>Lee,</actor> <actor>Linton,</actor> <actor>Montague,</actor> <actor>Norris,</actor> <actor>Shaw,</actor> <actor>Street,</actor> <actor>J. Taylor</actor><lb/>
                     <actor>Terry,</actor> <actor>Tett,</actor> <actor>S. Tett,</actor> <actor>Tinney,</actor> <actor>Treby,</actor> <actor>Williams</actor>-<actor>Mesdames Bolton,</actor> <actor>E. Bolton,</actor> <actor>Coates,</actor> <actor>Emery,</actor> <actor>Fawcett</actor><lb/>
                     <actor>Findlay,</actor> <actor>Grimaldi,</actor> <actor>Iliff,</actor> <actor>Johnson,</actor> <actor>Kniveton,</actor> <actor>Leserve,</actor> <actor>Liston,</actor> <actor>Logan,</actor> <actor>Price,</actor> <actor>Simes,</actor> <actor>Watts,</actor> <actor>Whitmore.</actor></castItem><lb/>
               </castList>
               To which will be added the Farce of<lb/>
               <bibl><title><hi rend="allcaps">All</hi> the <hi rend="allcaps">World'</hi>s a <hi rend="allcaps">Stage</hi>.</title></bibl><lb/>
