                  <castItem><role>William,</role> <actor>Mr. Sarjant,</actor></castItem> <castItem><role>Ralph,</role> <actor>Mr. Louis,</actor></castItem> <castItem><role>Robin,</role> <actor>Mr. Platt,</actor></castItem><lb/>
                  <castItem><role>Miss Bridget Pumpkin</role> by <actor>Mrs. <hi rend="allcaps">Davenport</hi>,</actor></castItem><lb/>
                  <castItem><role>Kitty Sprightly</role> by <actor>Miss <hi rend="allcaps">S. Booth</hi>,</actor></castItem><lb/>
