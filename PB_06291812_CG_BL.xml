                  <castItem><role>Siward</role> by <actor>Mr. <hi rend="allcaps">Atkins</hi>,</actor></castItem> <castItem><role>Seyton</role> by <actor>Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem> <castItem><role>Physician</role> by <actor>Mr. <hi rend="allcaps">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><role>Officers,</role> Mess. <actor>King</actor> &amp; <actor>Truman,</actor></castItem> <castItem><role>Chamberlains,</role> Mess. <actor>Heath</actor> &amp; <actor>Sarjant</actor></castItem>
                  <castItem><role>Lady Macbeth</role> by <actor>Mrs. <hi rend="allcaps">Siddons</hi>,</actor><lb/>
                  <hi rend="italic">Being the last time of Mrs. <hi rend="allcaps">Siddons</hi>'s appearing on the stage.</hi></castItem><lb/>
