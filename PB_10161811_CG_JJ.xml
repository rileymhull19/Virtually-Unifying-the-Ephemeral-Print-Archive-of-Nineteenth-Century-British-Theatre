         <div type="performance_playbill" rend="align(center)">
            <ab>Never Acted.<lb/>
               <placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">Theatre Royal, Covent-Garden,</hi></placeName><lb/>
