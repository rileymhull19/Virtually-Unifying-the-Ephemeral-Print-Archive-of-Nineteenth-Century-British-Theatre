  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#haymarket">Theatre-Royal, Hay-Market</placeName><lb/>
               This <hi rend="allcaps">Evening</hi>, <date when="1811-07-06"><hi rend="allcaps">Saturday</hi> July 6, 1811</date>.<lb/>
               Will be perform'd (<hi rend="italic">second time at this Theatre</hi>) the Musical Farce of The<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_poor_sailor">The <hi rend="allcaps">Poor Sailor</hi>;</title><lb/>
                  <title type="sub">Or, Little <hi rend="allcaps">Bob</hi> and Little <hi rend="allcaps">Ben</hi>.</title></bibl><lb/>
               <castList>
                  <castItem><role>Captain Battledore,</role> <actor ref="namedentities.xml#mr_barnes">Mr. <hi rend="allcaps">Barnes</hi>.</actor></castItem><lb/>
                  <castItem><role>Lieutenant Battledore,</role> <actor ref="namedentities.xml#mr_paine">Mr. <hi rend="allcaps">Paine</hi>.</actor></castItem><lb/>
                  <castItem><role>Compass,</role> <actor ref="namedentities.xml#mr_grove">Mr. <hi rend="allcaps">Grove</hi>.</actor></castItem> <castItem><role>Freakish,</role> <actor ref="namedentities.xml#mr_finn">Mr. <hi rend="allcaps">Finn</hi>.</actor></castItem><lb/>
                  <castItem><role>Bumbo,</role> <actor ref="namedentities.xml#mr_mallinson">Mr. <hi rend="allcaps">Mallinson</hi>.</actor></castItem><lb/>
                  <castItem><role>Daniel O'Daub,</role> <actor ref="namedentities.xml#mr_shaw">Mr. <hi rend="allcaps">Shaw</hi>.</actor></castItem><lb/>
                  <castItem><role>Lieut. of Press Gang,</role> <actor ref="namedentities.xml#ge_sm">Mr. Smith.</actor></castItem> <castItem><role>Sailors,</role> Messrs. <actor ref="namedentities.xml#mr_hodson">Hodson,</actor> <actor ref="namedentities.xml#mr_lewes">Lewes,</actor> <actor ref="namedentities.xml#mr_linton">Linton,</actor> <actor ref="namedentities.xml#mr_widdicombe">Widdicombe.</actor></castItem><lb/>
                  <castItem><role>Little Bob,</role> <actor ref="namedentities.xml#miss_carr">Miss <hi rend="allcaps">Carr</hi>.</actor></castItem><lb/>
                  <castItem><role>Nancy,</role> <actor ref="namedentities.xml#miss_bellchambers">Miss <hi rend="allcaps">Bellchambers</hi>.</actor></castItem> <castItem><role>Miss Ann Battledore,</role> <actor ref="namedentities.xml#mrs_grove">Mrs. <hi rend="allcaps">Grove</hi>.</actor></castItem><lb/>
                  <castItem><role>Eliza,</role> <actor ref="namedentities.xml#miss_wheatley">Miss <hi rend="allcaps">Wheatley</hi>.</actor></castItem><lb/>
               </castList>
               After which, (First Time this Season) The Comedy of The<lb/>
               <bibl><title ref="namedentities.xml#play_dramatist">Dramatist.</title></bibl><lb/>
               <castList>
                  <castItem><role>Vapid,</role> (with the Original Epilogue) <actor ref="namedentities.xml#ro_wi_el">Mr. <hi rend="allcaps">Elliston</hi>.</actor></castItem><lb/>
                  <castItem><role>Harry Neville,</role> <actor ref="namedentities.xml#mr_cooper">Mr. <hi rend="allcaps">Cooper</hi>.</actor></castItem><lb/>
                  <castItem><role>Ennui,</role> <actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi>.</actor></castItem><lb/>
                  <castItem><role>Floriville,</role> <actor ref="namedentities.xml#mr_r_jones">Mr. <hi rend="allcaps">R. Jones</hi>.</actor></castItem><lb/>
                  <castItem><role>Lord Scratch,</role> <actor ref="namedentities.xml#mr_grove">Mr. <hi rend="allcaps">Grove</hi>.</actor></castItem> <castItem><role>Willoughby,</role> <actor ref="namedentities.xml#ge_sm">Mr. <hi rend="allcaps">Smith</hi>.</actor></castItem><lb/>
                  <castItem><role>Peter,</role> <actor ref="namedentities.xml#mr_martin">Mr. Martin.</actor></castItem> <castItem><role>Servant,</role> <actor ref="namedentities.xml#mr_widdicombe">Mr. Widdicombe.</actor></castItem><lb/>
                  <castItem><role>Lady Waitfor't,</role> <actor ref="namedentities.xml#mrs_grove">Mrs. <hi rend="allcaps">Grove</hi>.</actor></castItem><lb/>
                  <castItem><role>Louisa Courtney,</role> <actor ref="namedentities.xml#mrs_smith">Mrs. <hi rend="allcaps">Smith</hi>.</actor></castItem> <castItem><role>Letty,</role> <actor ref="namedentities.xml#an_ma_le">Miss <hi rend="allcaps">Leserve</hi>.</actor></castItem><lb/>
                  <castItem><role>Marianne,</role> <actor ref="namedentities.xml#mrs_barnes">Mrs. <hi rend="allcaps">Barnes</hi>.</actor></castItem><lb/>   
               </castList>
               <hi rend="italic">After which</hi> <hi rend="allcaps">(Third Time)</hi> <hi rend="italic"><hi rend="allcaps">A New Farce</hi>, (with Songs,) call'd</hi> The<lb/>
               <bibl><title ref="namedentities.xml#play_outside_passenger">Outside Passenger.</title></bibl><lb/>
               <hi rend="italic">The Musick entirely new, Composed by <persName ref="namedentities.xml#wi_re">Mr. Reeve</persName>, <persName ref="namedentities.xml#mr_whitaker">Mr. Whitaker</persName>, and <persName ref="namedentities.xml#mr_d_corri">Mr. D. Corri</persName>.</hi><lb/>
               <hi rend="italic">The Overture by <persName ref="namedentities.xml#wi_re">Mr. Reeve</persName>.</hi><lb/>
               <castList>
                  <head>The Principal Characters by</head>
                  <castItem><actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#ed_ey">Mr. <hi rend="allcaps">Eyre</hi>.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_grove">Mr. <hi rend="allcaps">Grove</hi>.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_paine">Mr. <hi rend="allcaps">Paine</hi>.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_noble">Mr. Noble.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_finn">Mr. Finn</actor></castItem> <castItem><actor ref="namedentities.xml#mr_lewes">Mr. Lewes.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_mi">Mr. Minton.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_widdicombe">Mr. Widdicombe.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_mallinson">Mr. <hi rend="allcaps">Mallinson</hi>.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#an_ma_le">Miss <hi rend="allcaps">Leserve</hi>.</actor></castItem> <castItem><actor ref="namedentities.xml#miss_bellchambers">Miss <hi rend="allcaps">Bellchambers</hi>.</actor></castItem><lb/>
                  <castItem>And <actor ref="namedentities.xml#ma_gi">Mrs. <hi rend="allcaps">Gibbs</hi>.</actor></castItem><lb/>
               </castList>
               <hi rend="allcaps">Boxes</hi> <measure type="currency">5s</measure>. <hi rend="allcaps">Pit</hi> <measure type="currency">3s</measure>. <hi rend="allcaps">First Gallery</hi> <measure type="currency">2s</measure>. <hi rend="allcaps">Second Gallery</hi> <measure type="currency">1s</measure>.<lb/>
               The Doors to be Opened at <time when="18:00:00">Six o'Clock</time>, and the Performance to begin at <time when="19:00:00">Seven</time>.<lb/>
               Places for the Boxes to be taken of <persName ref="namedentities.xml#mr_mas">Mr. <hi rend="allcaps">Massingham</hi></persName> at the Theatre.<lb/>
               The Publick is respectfully inform'd, that, the <hi rend="smallcaps">New Farce</hi> call'd The <hi rend="allcaps">Outside</hi><lb/>
               <hi rend="allcaps">Passenger</hi>, having been received last night, with increased bursts of laughter, and loud<lb/>
               peels of applause, will be repeated; every evening, till further notice</ab>
         </div>
      </body>
  </text>
</TEI>
