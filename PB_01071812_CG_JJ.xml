         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">Theatre Royal, Covent Garden,</hi></placeName><lb/>
               This present <hi rend="allcaps">Tuesday</hi>, <date when="1812-01-07">Jan. 7, 1812</date> will be revived the Tragedy of<lb/>
               <bibl><title ref="namedentities.xml#play_percy"><hi rend="allcaps">Percy</hi>.</title></bibl><lb/>
               <castList>
                  <castItem><role>Percy, Earl of Northumberland,</role> <actor ref="namedentities.xml#ch_ke">Mr. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem> <castItem><role>Earl Douglas,</role> <actor ref="namedentities.xml#mr_young">Mr. <hi rend="allcaps">Young</hi>,</actor></castItem><lb/>
                  <castItem><role>Earl Raby,</role> <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem> <castItem><role>Sir Hubert,</role> <actor ref="namedentities.xml#da_eg">Mr. <hi rend="allcaps">Egerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Harcourt,</role> <actor ref="namedentities.xml#mr_brunton">Mr. <hi rend="allcaps">Brunton</hi>,</actor></castItem> <castItem><role>Edrick,</role> <actor ref="namedentities.xml#mr_hamerton">Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Knights</hi>,</role> Mess. <actor ref="namedentities.xml#mr_brown">Brown,</actor> <actor ref="namedentities.xml#mr_grant">Grant,</actor> <actor ref="namedentities.xml#mr_heath">Heath,</actor> <actor ref="namedentities.xml#mr_louis">Louis,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor ref="namedentities.xml#mr_powers">Powers,</actor> <actor ref="namedentities.xml#mr_sarjant">Sarjant,</actor> <actor ref="namedentities.xml#mr_yarnold">Yarnold</actor></castItem><lb/>
                  <castItem><role>Elwina</role> by <actor ref="namedentities.xml#miss_smith">Miss <hi rend="allcaps">Smith</hi>,</actor></castItem><lb/>
                  <castItem><role>Birtha,</role> <actor ref="namedentities.xml#miss_e_bolton">Miss <hi rend="allcaps">E. Bolton</hi>,</actor></castItem><lb/>
               </castList>
               After which will be performed, <hi rend="italic">for the 11th time, a <hi rend="allcaps">New Pantomime</hi>, called</hi><lb/>
               <bibl><title type="main" ref="namedentities.xml#play_harlequin_and_padmanaba">Harlequin &amp; Padmanaba</title><lb/>
                  <title type="sub"><hi rend="allcaps">Or</hi><lb/>
                     <hi rend="allcaps">The Golden Fish.</hi></title></bibl><lb/>
               The Overture and Musick composed by <persName ref="namedentities.xml#mr_ware">Mr. <hi rend="italic">Ware</hi></persName>.<lb/>
               <hi rend="italic">The Scenery painted by Mess. <persName ref="namedentities.xml#sa_wh">Whitmore</persName>, <persName ref="namedentities.xml#ch_jo_pu">Pugh</persName>, <persName ref="namedentities.xml#jo_he_gr">Grieve</persName>, <persName ref="namedentities.xml#j_ho">Hollogan</persName>, &amp; their assistants.</hi><lb/>
               The Machinery by Mess. <persName ref="namedentities.xml#mr_bradwell">Bradwell</persName>, <persName ref="namedentities.xml#mr_saul">Saul</persName>, &amp; <persName ref="namedentities.xml#jo_cr">Cresswell, jun</persName>. The Dresses by <persName ref="namedentities.xml#mr_flowers">Mr. Flowers</persName> &amp; <persName ref="namedentities.xml#miss_egan">Miss Egan</persName>.<lb/>
               The Dances composed by <persName ref="namedentities.xml#jo_pi_bo">Mr. Bologna, Jun</persName>.-The whole arranged by <persName ref="namedentities.xml#ch_fa">Mr. Farley</persName>.<lb/>
               <castList>
                  <castItem><role><hi rend="allcaps">Padmanaba</hi> (a renowned Astrologer</role> <actor>Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Sultan</hi> of <hi rend="allcaps">Chashmire</hi>, (afterwards Pantaloon)</role> <actor ref="namedentities.xml#jo_no">Mr. <hi rend="allcaps">Norman</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Omar</hi>, the Fisherman, (afterwards Harlequin)</role> <actor ref="namedentities.xml#jo_pi_bo">Mr. <hi rend="allcaps">Bologna,</hi> Jun.</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Cayfacttadhre</hi>, the Persian Cook, (afterwards Clown)</role> <actor ref="namedentities.xml#jo_gr">Mr. <hi rend="allcaps">Grimaldi</hi>,</actor></castItem><lb/>
                  <castItem><role>Grand Vizier,</role> <actor ref="namedentities.xml#mr_how">Mr. <hi rend="allcaps">Howell</hi>,</actor></castItem> <castItem><role>Nekir <hi rend="italic">(the Black Evil Spirit)</hi></role> <actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem><lb/>
                  <castItem><role>Zadig, the old Fisherman,</role> <actor ref="namedentities.xml#mr_tinney">Mr. <hi rend="allcaps">Tinney</hi>,</actor></castItem> <castItem><role>Selim, his son,</role> <actor ref="namedentities.xml#mr_broadhurst">Mr. <hi rend="allcaps">Broadhurst</hi>,</actor></castItem><lb/>
                  <castItem><role>Priz,</role> <actor ref="namedentities.xml#mr_huckel">Mr. <hi rend="allcaps">Huckel</hi>,</actor></castItem> <castItem><role>Chief of the Haram,</role> <actor ref="namedentities.xml#mr_louis">Mr. <hi rend="allcaps">Louis</hi>,</actor></castItem> <castItem><role>Clerk of the Sultan's Kitchen,</role> <actor ref="namedentities.xml#mr_heath">Mr. <hi rend="allcaps">Heath</hi>,</actor></castItem><lb/>
                  <castItem><role>Scullions,</role> Masters <actor ref="namedentities.xml#mr_bradwell">Bradwell,</actor> <actor ref="namedentities.xml#mr_chapman">Chapman,</actor> <actor ref="namedentities.xml#mr_goodwin">Goodwin,</actor> <actor ref="namedentities.xml#mr_morelli">Morelli,</actor> <actor ref="namedentities.xml#mr_wilson">Wilson,</actor> <actor ref="namedentities.xml#mr_yarnold">Yarnold</actor></castItem><lb/>
                  <castItem><role>Slaves,</role> Mess. <actor ref="namedentities.xml#mr_baker">Baker,</actor> <actor ref="namedentities.xml#mr_j_cardozo">J. Cardozo,</actor> <actor ref="namedentities.xml#mr_foffee">Foffee,</actor> <actor ref="namedentities.xml#mr_griffiths">Griffiths,</actor> <actor ref="namedentities.xml#mr_jeffkins">Jeffkins,</actor></castItem><lb/>
                  <castItem><role>Welch Colliers</role> Mess. <actor ref="namedentities.xml#mr_banks">Banks,</actor> <actor ref="namedentities.xml#mr_goodwin">Goodwin,</actor> <actor ref="namedentities.xml#mr_griffiths">W. Griffiths,</actor> <actor ref="namedentities.xml#mr_jeffkins">J. Jeffkins,</actor> <actor ref="namedentities.xml#mr_telfer">Telfer,</actor> <actor ref="namedentities.xml#mr_truman">W. Truman</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Sheep Shearers,</hi></role> Mess. <actor ref="namedentities.xml#mr_brown">Brown,</actor> <actor ref="namedentities.xml#mr_grant">Grant,</actor> <actor ref="namedentities.xml#mr_heath">Heath,</actor> <actor ref="namedentities.xml#mr_louis">Louis,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor ref="namedentities.xml#mr_powers">Powers,</actor> <actor ref="namedentities.xml#mr_sarjant">Sarjant,</actor> <actor ref="namedentities.xml#mr_yarnold">Yarnold.</actor></castItem>
                  <castItem><role><hi rend="allcaps">Zelica</hi>, the Sultan's Daughter, (afterwards Colombine)</role> <actor ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi>,</actor></castItem><lb/>
                  <castItem><role>Morea, the Fisherman's Daughter,</role> <actor>Miss <hi rend="allcaps">E. Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Huntresses, Welch Women, Shepherdesses, and Persian Dancers,</hi></role> <hi rend="italic">by</hi><lb/>
                     Mesdames <actor ref="namedentities.xml#mrs_bologna">Bologna,</actor> <actor ref="namedentities.xml#mrs_i_bologna">I. Bologna,</actor> <actor ref="namedentities.xml#mrs_cox">Cox,</actor> <actor ref="namedentities.xml#mrs_heath">Heath,</actor> <actor ref="namedentities.xml#mrs_louis">Louis,</actor> <actor ref="namedentities.xml#mrs_ryall">Ryall,</actor> <actor ref="namedentities.xml#mrs_standen">Standen,</actor> <actor ref="namedentities.xml#mrs_watts">Watts,</actor></castItem><lb/>
                  <castItem><role>Old Maid,</role> <actor ref="namedentities.xml#el_co">Mrs. <hi rend="allcaps">Coates</hi>,</actor></castItem> <castItem><role>Milk-maid,</role> <actor ref="namedentities.xml#mrs_findlay">Mrs. <hi rend="allcaps">Findlay</hi>,</actor></castItem> <castItem><role>Milliner,</role> <actor ref="namedentities.xml#mrs_hardy">Mrs. <hi rend="allcaps">Hardy</hi>,</actor></castItem><lb/>
                  <castItem><role>The Fairy Cheheristany,</role> <actor ref="namedentities.xml#miss_worgman">Miss <hi rend="allcaps">Worgman</hi>,</actor></castItem><lb/>
               </castList>
               <hi rend="italic">No <hi rend="allcaps">Orders</hi> can be admitted.</hi><lb/>
               Vivant Rex &amp; Regina.</ab>
