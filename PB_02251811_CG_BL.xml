  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">New Theatre Royal, Covent-Garden,</hi></placeName><lb/>
               This present <hi rend="allcaps">Monday</hi>, <date when="1811-02-25">Feb. 25, 1811</date> will be acted <persName ref="namedentities.xml#wi_sha"><hi rend="italic">Shakspeare's</hi></persName> Tragedy of<lb/>
               <bibl><title ref="namedentities.xml#play_romeo_and_juliet"><hi rend="allcaps">Romeo and Juliet.</hi></title></bibl><lb/>
               <castList>
                  <castItem><role>Prince Escalus</role> by <actor ref="namedentities.xml#mr_claremont">Mr. <hi rend="allcaps">Claremont,</hi></actor></castItem> <castItem><role>Paris</role> by <actor ref="namedentities.xml#mr_hamerton">Mr. <hi rend="allcaps">Hamerton,</hi></actor></castItem><lb/>
                  <castItem><role>Montague</role> by <actor ref="namedentities.xml#mr_creswell">Mr. <hi rend="allcaps">Cresswell,</hi></actor></castItem> <castItem><role>Capulet</role> by <actor ref="namedentities.xml#da_eg">Mr. <hi rend="allcaps">Egerton,</hi></actor></castItem><lb/>
                  <castItem><role>Romeo</role> by <actor ref="namedentities.xml#ch_ke">Mr. <hi rend="allcaps">C. Kemble,</hi></actor></castItem> <castItem><role>Mercutio</role> by <actor ref="namedentities.xml#mr_jones">Mr. <hi rend="allcaps">Jones,</hi></actor></castItem> <castItem><role>Benvolio</role> by <actor ref="namedentities.xml#mr_brunton">Mr. <hi rend="allcaps">Brunton,</hi></actor></castItem><lb/>
                  <castItem><role>Tybalt</role> by <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore,</hi></actor></castItem> <castItem><role>Friar Laurence</role> by <actor ref="namedentities.xml#ch_mu">Mr. <hi rend="allcaps">Murray,</hi></actor></castItem> <castItem><role>Friar John</role> by <actor ref="namedentities.xml#ge_go_da">Mr. Davenport,</actor></castItem><lb/>
                  <castItem><role>Apothecary,</role> <actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><role>Page</role> <actor ref="namedentities.xml#mr_chapman">Master <hi rend="allcaps">Chapman,</hi></actor></castItem> <castItem><role>Balthasar</role> by <actor ref="namedentities.xml#mr_jefferies"><hi rend="allcaps">Mr. Jefferies,</hi></actor></castItem><lb/>
                  <castItem><role>Abram</role> <actor ref="namedentities.xml#mr_bishop">Mr. Bishop,</actor></castItem> <castItem><role>Samson</role> <actor ref="namedentities.xml#wi_at">Mr. Atkins,</actor></castItem> <castItem><role>Gregory</role> <actor ref="namedentities.xml#mr_truman">Mr. Truman,</actor></castItem> <castItem><role>Peter</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons,</hi></actor></castItem><lb/>
                  <castItem><role>Lady Capulet</role> by <actor ref="namedentities.xml#mrs_weston">Mrs. <hi rend="allcaps">Weston,</hi></actor></castItem><lb/>
                  <castItem><role>Juliet</role> by <actor ref="namedentities.xml#sa_eg">Mrs. <hi rend="allcaps">Egerton,</hi><lb/>
                  <hi rend="italic">(From the Theatre Royal Birmingham, being her first appearance in London.)</hi></actor></castItem><lb/>
                  <castItem><role>Nurse</role> by <actor ref="namedentities.xml#ma_an_da">Mrs. <hi rend="allcaps">Davenport,</hi></actor></castItem><lb/>
               </castList>
               <hi rend="italic">In act I. a <hi rend="allcaps">Masquerade</hi> and <hi rend="allcaps">Dance</hi> incidental to the Play.</hi><lb/>
               <hi rend="italic">In act IV.</hi> The Funeral Procession of Juliet and a Solemn Dirge.<lb/>
               The Vocal Parts by Mess. <persName ref="namedentities.xml#mr_bellamy">Bellamy</persName>, <persName ref="namedentities.xml#mr_i_bellamy">I. Bellamy</persName>, <persName ref="namedentities.xml#mr_bishop">Bishop</persName>, <persName ref="namedentities.xml#mr_bond">Bond</persName>, <persName ref="namedentities.xml#mr_dixon">Dixon</persName>, <persName ref="namedentities.xml#mr_everard">Everard</persName>, <persName ref="namedentities.xml#mr_fairclough">Fairclough</persName>, <persName ref="namedentities.xml#mr_hickman">Hickman</persName>, <persName ref="namedentities.xml#mr_lee">Lee</persName>,<lb/>
               <persName ref="namedentities.xml#mr_linton">Linton</persName>, <persName ref="namedentities.xml#mr_montague">Montague</persName>, <persName ref="namedentities.xml#mr_norris">Norris</persName>, <persName ref="namedentities.xml#ja_st">Street</persName>, <persName ref="namedentities.xml#mr_taylor">Taylor</persName>, <persName ref="namedentities.xml#mr_j_taylor">J. Taylor</persName>, <persName ref="namedentities.xml#mr_terry">Terry</persName>, <persName ref="namedentities.xml#jo_te">Tett</persName>, <persName ref="namedentities.xml#mr_tinney">Tinney</persName>, <persName ref="namedentities.xml#mr_treby">Treby</persName>, <persName ref="namedentities.xml#mr_williams">Williams</persName>,<lb/>
               Mesdames <persName ref="namedentities.xml#mrs_bologna">Bologna</persName>, <persName ref="namedentities.xml#mrs_i_bologna">I. Bologna</persName>, <persName ref="namedentities.xml#mrs_bolton">Bolton</persName>, <persName ref="namedentities.xml#el_co">Coates</persName>, <persName ref="namedentities.xml#mrs_cox">Cox</persName>, <persName ref="namedentities.xml#jo_em">Emery</persName>, <persName ref="namedentities.xml#jo_fa">Fawcett</persName>, <persName ref="namedentities.xml#mrs_findlay">Findlay</persName>, <persName ref="namedentities.xml#mrs_grimaldi">Grimaldi</persName>, <persName ref="namedentities.xml#mrs_hardy">Hardy</persName>, <persName ref="namedentities.xml#mrs_heath">Heath</persName>,<lb/>
               <persName ref="namedentities.xml#mrs_iliff">Iliff</persName>, <persName ref="namedentities.xml#mrs_johnson">Johnson</persName>, <persName ref="namedentities.xml#an_ma_le">Leserve</persName>, <persName ref="namedentities.xml#mrs_linton">Linton</persName>, <persName ref="namedentities.xml#mrs_logan">Logan</persName>, <persName ref="namedentities.xml#mrs_price">Price</persName>, <persName ref="namedentities.xml#mrs_ryall">Ryall</persName>, <persName ref="namedentities.xml#mrs_standen">Standen</persName>, <persName ref="namedentities.xml#mrs_watts">Watts</persName>, <persName ref="namedentities.xml#h_wh">Whitmore</persName>,<lb/>
               The Tragedy of <hi rend="italic">Romeo and Juliet</hi> is printed comformably to the performation, and<lb/>
               will be to be had [<hi rend="italic">only at the Theatre</hi>] this Evening.<lb/>
               To which will be added, <hi rend="italic">for the 7th time</hi>, the <hi rend="allcaps">Grand Dramatick Romance</hi> of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
                  <title type="sub"><hi rend="italic">Or, Female Curiosity.</hi></title></bibl><lb/>
               <hi rend="italic">With entirely new Scenes, Machinery, Dresses and Decorations.</hi><lb/>
               <hi rend="italic">The Musick composed and selected by <persName ref="namedentities.xml#mi_ke">Mr. <hi rend="allcaps">Kelly</hi></persName>.</hi><lb/>
               <castList>
                  <castItem><role>Abomelique,</role> <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Ibrahim,</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons</hi>,</actor></castItem> <castItem><role>Selim,</role> <actor ref="namedentities.xml#mr_taylor">Mr. <hi rend="allcaps">Taylor</hi>,</actor></castItem><lb/>
                  <castItem><role>Shacabac,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem><lb/>
                  <castItem><role>Hassan,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem><lb/>
                  <castItem><role>Fatima,</role> <actor ref="namedentities.xml#miss_bolyon">Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>Irene,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Beda,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic"><hi rend="allcaps">Spahis</hi></hi>,</role><lb/>
                     Mess. <actor ref="namedentities.xml#mr_treby">Treby,</actor> <actor ref="namedentities.xml#mr_king">King,</actor> <actor ref="namedentities.xml#mr_bishop">Bishop,</actor> <actor ref="namedentities.xml#mr_hickman">Hickman,</actor> <actor ref="namedentities.xml#mr_droset">Droset,</actor> <actor ref="namedentities.xml#mr_norris">Norris,</actor> <actor ref="namedentities.xml#mr_tinney">Tinney,</actor> <actor ref="namedentities.xml#mr_crossman">Crossman,</actor><lb/>
                     <actor ref="namedentities.xml#mr_davies">Davies,</actor> <actor ref="namedentities.xml#mr_makeen">Makeen,</actor> &amp;c. &amp;c.</castItem><lb/>
                  <castItem><role><hi rend="allcaps"><hi rend="italic">Janizaries</hi></hi>,</role><lb/>
                     Mess. <actor ref="namedentities.xml#mr_i_bellamy">I. Bellamy,</actor> <actor ref="namedentities.xml#mr_bond">Bond,</actor> <actor ref="namedentities.xml#mr_dixon">Dixon,</actor> <actor ref="namedentities.xml#mr_everard">Everard,</actor> <actor ref="namedentities.xml#mr_fairclough">Fairclough,</actor> <actor ref="namedentities.xml#mr_lee">Lee,</actor> <actor ref="namedentities.xml#mr_linton">Linton,</actor> <actor ref="namedentities.xml#mr_montague">Montague,</actor> <actor ref="namedentities.xml#jo_no">Norman,</actor> <actor ref="namedentities.xml#ja_st">Street</actor><lb/>
                     <actor ref="namedentities.xml#mr_j_taylor">J. Taylor,</actor> <actor ref="namedentities.xml#mr_terry">Terry,</actor> <actor ref="namedentities.xml#jo_te">Tett,</actor> <actor ref="namedentities.xml#mr_williams">Williams,</actor></castItem>
                  <castItem><role><hi rend="allcaps"><hi rend="allcaps">Peasants</hi></hi>,</role><lb/>
                     Mesdames <actor ref="namedentities.xml#el_co">Coates,</actor> <actor ref="namedentities.xml#mrs_findlay">Findlay,</actor> <actor ref="namedentities.xml#mrs_grimaldi">Grimaldi,</actor> <actor ref="namedentities.xml#mrs_hardy">Hardy,</actor> <actor ref="namedentities.xml#mrs_iliff">Iliff,</actor> <actor ref="namedentities.xml#mrs_johnson">Johnson,</actor> <actor ref="namedentities.xml#mrs_price">Price,</actor> <actor ref="namedentities.xml#h_wh">Whitmore</actor>,<lb/></castItem>
               </castList>
               <hi rend="italic">The Dances by</hi><lb/>
               <persName ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi></persName>,<lb/>
               Mess. <persName ref="namedentities.xml#mr_brown">Brown</persName>, <persName ref="namedentities.xml#mr_gaywood">Gaywood</persName>, <persName ref="namedentities.xml#mr_grant">Grant</persName>, <persName ref="namedentities.xml#mr_heath">Heath</persName>, <persName ref="namedentities.xml#mr_louis">Louis</persName>, <persName ref="namedentities.xml#mr_pl">Platt</persName>, <persName ref="namedentities.xml#mr_powers">Powers</persName>, <persName ref="namedentities.xml#mr_sarjant">Sarjant</persName>,<lb/>
               Mesdames <persName ref="namedentities.xml#mrs_bologna">Bologna</persName>, <persName ref="namedentities.xml#mrs_i_bologna">I. Bologna</persName>, <persName ref="namedentities.xml#mrs_cox">Cox</persName>, <persName ref="namedentities.xml#mrs_heath">Heath</persName>, <persName ref="namedentities.xml#mrs_louis">Louis</persName>, <persName ref="namedentities.xml#mrs_ryall">Ryall</persName>, <persName ref="namedentities.xml#mrs_standen">Standen</persName>, <persName ref="namedentities.xml#mrs_watts">Watts</persName>.<lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina</hi>.<lb/>
               The Grand Dramatick Romance of <hi rend="allcaps">Blue Beard</hi>; or, <hi rend="smallcaps">Female Curisoity</hi>,<lb/>
               continuing to be recieved throughout with universal applause, will be repeated every<lb/>
               Evening till further notice.</ab>
         </div>
