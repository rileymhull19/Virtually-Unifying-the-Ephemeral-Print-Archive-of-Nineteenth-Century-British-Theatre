                  <castItem><role><hi rend="italic">Foresters</hi>,</role> Mess. <actor ref="namedentities.xml#mr_bishop">Bishop,</actor> <actor ref="namedentities.xml#mr_bond">Bond,</actor> <actor ref="namedentities.xml#mr_lee">Lee, </actor> <actor ref="namedentities.xml#mr_norris">Norris,</actor></castItem><lb/>
