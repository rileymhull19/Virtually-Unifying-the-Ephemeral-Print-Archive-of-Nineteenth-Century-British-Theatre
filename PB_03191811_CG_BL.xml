  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><persName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">New Theatre Royal, Covent-Garden,</hi></persName><lb/>
               This present <hi rend="allcaps">Tuesday</hi>, <date when="1811-03-19">March 19, 1811</date>, will be acted <hi rend="italic">Shakspeare's</hi> Comedy of<lb/>
               <bibl><title ref="namedentities.xml#play_as_you_like_it"><hi rend="allcaps">As You Like It.</hi></title></bibl><lb/>
               <castList>
                  <castItem><role>The Duke</role> by <actor ref="namedentities.xml#da_eg">Mr. <hi rend="allcaps">Egerton</hi>,</actor></castItem> <castItem><role>Duke Frederick</role> by <actor>Mr. <hi rend="allcaps">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><role>Amiens</role> by <actor ref="namedentities.xml#ch_be_in">Mr. <hi rend="allcaps">Incledon</hi>,</actor></castItem> <castItem><role>Jaques</role> by <actor ref="namedentities.xml#jo_ph_ke">Mr. <hi rend="allcaps">Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Le Beau</role> by <actor>Mr. <hi rend="allcaps">Treby</hi>,</actor></castItem> <castItem><role>Eustace,</role> <actor>Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><role>Louis,</role> <actor>Mr. <hi rend="allcaps">Field</hi>,</actor></castItem><lb/>
                  <castItem><role>Oliver</role> by <actor>Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem> <castItem><role>Jacques de Bois</role> by <actor>Mr. <hi rend="allcaps">Claremont</hi>,</actor></castItem> <castItem><role>Orlando</role> by <actor ref="namedentities.xml#ch_ke">Mr. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Adam</role> by <actor ref="namedentities.xml#ch_mu">Mr. <hi rend="allcaps">Murray</hi>,</actor></castItem> <castItem><role>Charles</role> by <actor>Mr. <hi rend="allcaps">Cresswell</hi>,</actor></castItem><lb/>
                  <castItem><role>Dennis,</role> <actor>Mr. <hi rend="allcaps">Sarjant</hi>,</actor></castItem> <castItem><role>Silvius,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem> <castItem><role>Corin,</role> <actor ref="namedentities.xml#ge_go_da">Mr. <hi rend="allcaps">Davenport</hi>,</actor></castItem><lb/>
                  <castItem><role>William</role> by <actor ref="namedentities.xml#wi_bl">Mr. <hi rend="allcaps">Blanchard</hi>,</actor></castItem> <castItem><role>Touchstone</role> by <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Foresters</hi>,</role> Mess. <actor>Bishop,</actor> <actor>Bond,</actor> <actor>Lee, </actor> <actor>Norris,</actor></castItem><lb/>
                  <castItem><role>Gentlemen,</role> Mess. <actor>Brown,</actor> <actor>Gaywood,</actor> <actor>Grant,</actor> <actor>Heath,</actor> <actor>Louis,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor>Powers,</actor> <actor>Sarjant</actor></castItem><lb/>
                  <castItem><role>Rosalind</role> by <actor ref="namedentities.xml#ma_an_eg">Mrs. <hi rend="allcaps">Egerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Celia</role> by <actor>Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem> <castItem><role>Phoebe</role> by <actor>Miss <hi rend="allcaps">Fenwick</hi>,</actor></castItem><lb/>
                  <castItem><role>Audrey</role> by <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>     
               </castList>
               In Act V. <hi rend="italic"><hi rend="allcaps">A Masque</hi> incidental to the Piece.</hi><lb/>
               <castList>
                  <castItem><role>Hymen</role> by <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem> <castItem><role>Cupids,</role> by <actor>Miss Shotter</actor> and <actor>Miss Goodwin.</actor></castItem><lb/>
               </castList>
               <hi rend="italic">The <hi rend="allcaps">Dance</hi> by</hi><lb/>
               Mess. <persName>Brown</persName>, <persName>Gaywood</persName>, <persName>Grant</persName>, <persName>Heath</persName>, <persName>Louis</persName>, <persName ref="namedentities.xml#mr_pl">Platt</persName>, <persName>Powers</persName>, <persName>Sarjant</persName><lb/>
               Mesdames <persName>Bologna</persName>, <persName>I. Bologna</persName>, <persName>Cox</persName>, <persName>Heath</persName>, <persName>Louis</persName>, <persName>Ryall</persName>, <persName>Standen</persName>, <persName>Watts</persName>.<lb/>
               The Comedy of <hi rend="italic">As You Like It</hi> is printed conformably to the representation, and<lb/>
               will be to be had [<hi rend="italic">only at the Theatre</hi>] this Evening.<lb/>
               To which will be added, <hi rend="italic">for the 20th time</hi>, the <hi rend="allcaps">Grand Dramatick Romance</hi> of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
                  <title type="sub"><hi rend="italic">Or,Female Curiosity.</hi></title></bibl><lb/>
               <hi rend="italic">The Musick composed by <persName ref="namedentities.xml#mi_ke">Mr. <hi rend="allcaps">Kelly</hi></persName>.</hi><lb/>
               <castList>
                  <castItem><role>Abomelique,</role> <actor>Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Ibrahim,</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons</hi>,</actor></castItem> <castItem><role>Selim,</role> <actor>Mr. <hi rend="allcaps">Taylor</hi>,</actor></castItem><lb/>
                  <castItem><role>Shacabac,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><role>Hassan,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem><lb/>
                  <castItem><role>Fatima,</role> <actor>Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>Irene,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Beda,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Spahis</hi>,</role> Mess. <actor>Treby,</actor> <actor>King,</actor> <actor>Bishop,</actor> <actor>Hickman,</actor> <actor>Droset,</actor> <actor>Norris,</actor> <actor>Tinney,</actor> <actor>Crossman,</actor><lb/>
                     <actor>Davies,</actor> <actor>Makeen,</actor> &amp;c. &amp;c.</castItem><lb/>
                  <castItem><role><hi rend="italic">Janizaries</hi>,</role> Mess. <actor>I. Bellamy,</actor> <actor>Bond,</actor> <actor>Dixon,</actor> <actor>Everard,</actor> <actor>Fairclough,</actor> <actor>Lee,</actor> <actor>Linton,</actor> <actor>Montague,</actor> <actor ref="namedentities.xml#jo_no">Norman,</actor> <actor ref="namedentities.xml#ja_st">Street</actor><lb/>
                     <actor>J. Taylor,</actor> <actor>Terry,</actor> <actor ref="namedentities.xml#jo_te">Tett,</actor> <actor>Williams,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Peasants</hi>,</role>Mesdames <actor ref="namedentities.xml#el_co">Coates,</actor> <actor>Findlay,</actor> <actor>Grimaldi,</actor> <actor>Hardy,</actor> <actor>Iliff,</actor> <actor>Johnson,</actor> <actor>Price,</actor> <actor ref="namedentities.xml#h_wh">Whitmore</actor>,</castItem><lb/>
               </castList>
               <hi rend="italic">The Dances by</hi><lb/>
               <persName ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi></persName>,<lb/>
               Mess. <persName>Brown</persName>, <persName>Gaywood</persName>, <persName>Grant</persName>, <persName>Heath</persName>, <persName>Louis</persName>, <persName ref="namedentities.xml#mr_pl">Platt</persName>, <persName>Powers</persName>, <persName>Sarjant</persName>,<lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina</hi>.<lb/>
               The Grand Dramatick Romance of <hi rend="allcaps">Blue Beard</hi>; or, <hi rend="smallcaps">Female Curisoity</hi>,<lb/>
               continuing to be recieved throughout with universal applause, will be repeated every<lb/>
               Evening till further notice.</ab>
         </div>
      </body>
  </text>
