                  <castItem><role>Adam</role> by <actor ref="namedentities.xml#ch_mu">Mr. <hi rend="allcaps">Murray</hi>,</actor></castItem> <castItem><role>Charles</role> by <actor ref="namedentities.xml#mr_cresswell">Mr. <hi rend="allcaps">Cresswell</hi>,</actor></castItem><lb/>
                  <castItem><role>Dennis,</role> <actor ref="namedentities.xml#mr_sarjant">Mr. <hi rend="allcaps">Sarjant</hi>,</actor></castItem> <castItem><role>Silvius,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem> <castItem><role>Corin,</role> <actor ref="namedentities.xml#ge_go_da">Mr. <hi rend="allcaps">Davenport</hi>,</actor></castItem><lb/>
