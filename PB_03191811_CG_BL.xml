               Mess. <persName ref="namedentities.xml#mr_brown">Brown</persName>, <persName ref="namedentities.xml#mr_gaywood">Gaywood</persName>, <persName ref="namedentities.xml#mr_grant">Grant</persName>, <persName ref="namedentities.xml#mr_heath">Heath</persName>, <persName ref="namedentities.xml#mr_louis">Louis</persName>, <persName ref="namedentities.xml#mr_pl">Platt</persName>, <persName ref="namedentities.xml#mr_powers">Powers</persName>, <persName ref="namedentities.xml#mr_sarjant">Sarjant</persName><lb/>
               Mesdames <persName ref="namedentities.xml#mrs_bologna">Bologna</persName>, <persName ref="namedentities.xml#mrs_i_bologna">I. Bologna</persName>, <persName ref="namedentities.xml#mrs_cox">Cox</persName>, <persName ref="namedentities.xml#mrs_heath">Heath</persName>, <persName ref="namedentities.xml#mrs_louis">Louis</persName>, <persName ref="namedentities.xml#mrs_ryall">Ryall</persName>, <persName ref="namedentities.xml#mrs_standen">Standen</persName>, <persName ref="namedentities.xml#mrs_watts">Watts</persName>.<lb/>
               The Comedy of <hi rend="italic">As You Like It</hi> is printed conformably to the representation, and<lb/>
               will be to be had [<hi rend="italic">only at the Theatre</hi>] this Evening.<lb/>
               To which will be added, <hi rend="italic">for the 20th time</hi>, the <hi rend="allcaps">Grand Dramatick Romance</hi> of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
                  <title type="sub"><hi rend="italic">Or, Female Curiosity.</hi></title></bibl><lb/>
