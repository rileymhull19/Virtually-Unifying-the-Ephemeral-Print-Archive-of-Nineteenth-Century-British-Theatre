                  <castItem><actor ref="namedentities.xml#ch_fa">Mr. <hi rend="allcaps">Farley</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#wi_bl">Mr. <hi rend="allcaps">Blanchard</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mrs_bishop">Mrs. <hi rend="allcaps">Bishop</hi>,</actor></castItem><lb/>
