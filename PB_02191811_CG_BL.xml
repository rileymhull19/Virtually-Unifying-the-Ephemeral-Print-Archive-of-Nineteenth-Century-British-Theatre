                  <castItem><role><hi rend="allcaps"><hi rend="italic">Janizaries</hi></hi>,</role><lb/>
                     Mess. <actor ref="namedentities.xml#mr_i_bellamy">I. Bellamy,</actor> <actor ref="namedentities.xml#mr_bond">Bond,</actor> <actor ref="namedentities.xml#mr_dixon">Dixon,</actor> <actor ref="namedentities.xml#mr_everard">Everard,</actor> <actor ref="namedentities.xml#mr_fairclough">Fairclough,</actor> <actor ref="namedentities.xml#mr_lee">Lee,</actor> <actor ref="namedentities.xml#mr_limon">Limon,</actor> <actor ref="namedentities.xml#mr_montague">Montague,</actor> <actor ref="namedentities.xml#jo_no">Norman,</actor> <actor ref="namedentities.xml#ja_st">Street</actor><lb/>
