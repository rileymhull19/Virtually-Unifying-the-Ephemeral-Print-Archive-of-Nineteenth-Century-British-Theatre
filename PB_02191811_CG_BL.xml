                  <castItem><role>Roberto,</role> <actor ref="namedentities.xml#mr_jefferies">Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem> <castItem><role>Friar,</role> <actor ref="namedentities.xml#wi_at">Mr. <hi rend="allcaps">Atkins</hi>,</actor></castItem> <castItem><role>Officer,</role> <actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><role>Malvolio,</role> <actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi></actor></castItem><lb/>
                  <castItem><role>Clown,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><role>Fabian,</role> <actor ref="namedentities.xml#ch_fa">Mr. <hi rend="allcaps">Farley</hi>,</actor></castItem> <castItem><role>Pietro,</role> <actor ref="namedentities.xml#mr_sarjant">Mr. <hi rend="allcaps">Sarjant</hi>,</actor></castItem> <castItem><role>Luigi,</role> <actor ref="namedentities.xml#mr_heath">Mr. <hi rend="allcaps">Heath</hi>,</actor></castItem> <castItem><role>Sailor,</role> <actor ref="namedentities.xml#mr_powers">Mr. <hi rend="allcaps">Powers</hi>,</actor></castItem>
                  <castItem><role>Olivia,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem> <castItem><role>Viola,</role> <actor ref="namedentities.xml#sa_bo">Miss <hi rend="allcaps">S. Booth</hi>,</actor></castItem> <castItem><role>Maria,</role> <actor ref="namedentities.xml#ma_gi">Mrs. <hi rend="allcaps">Gibbs</hi></actor></castItem><lb/>
               </castList>
               To which will be added, <hi rend="italic">for the second time</hi>, the <hi rend="allcaps">Grand Dramatick Romance</hi> of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
