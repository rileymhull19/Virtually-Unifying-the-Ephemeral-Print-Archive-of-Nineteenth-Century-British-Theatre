      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="allcaps">New Theatre Royal, Covent-Garden</hi></placeName><lb/>
               This present <hi rend="allcaps">Tuesday</hi>, <date when="1811-02-19">Feb. 19, 1811</date>, will be acted (6th time) the Comedy of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_twelfth_night">The <hi rend="allcaps">Twelfth Night</hi>;</title><lb/>
                  <title type="sub"><hi rend="italic">Or, <hi rend="allcaps">What You Will</hi>.</hi></title></bibl><lb/>
               <castList>
                  <castItem><role>Duke Orsino,</role> <actor>Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem> <castItem><role>Valentine,</role> <actor>Mr. <hi rend="allcaps">Claremont</hi>,</actor></castItem> <castItem><role>Curio,</role> <actor>Mr. <hi rend="allcaps">Field</hi>,</actor></castItem><lb/>
                  <castItem><role>Paolo,</role> <actor>Mr. <hi rend="allcaps">Bishop</hi>,</actor></castItem> <castItem><role>Cosino,</role> <actor>Mr. <hi rend="allcaps">Bond</hi>,</actor></castItem> <castItem><role>Sir Toby Belch,</role> <actor ref="namedentities.xml#jo_em">Mr. <hi rend="allcaps">Emery</hi>,</actor></castItem><lb/>
                  <castItem><role>Sir Andrew Ague-Cheek,</role> <actor ref="namedentities.xml#wi_bl">Mr. <hi rend="allcaps">Blanchard</hi>,</actor></castItem> <castItem><role>Sebastian,</role> <actor>Mr. <hi rend="allcaps">Brunton</hi>,</actor></castItem> <castItem><role>Antonio,</role> <actor>Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Roberto,</role> <actor>Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem> <castItem><role>Friar,</role> <actor ref="namedentities.xml#wi_at">Mr. <hi rend="allcaps">Atkins</hi>,</actor></castItem> <castItem><role>Officer,</role> <actor>Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><role>Malvolio,</role> <actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi></actor></castItem><lb/>
                  <castItem><role>Clown,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><role>Fabian,</role> <actor ref="namedentities.xml#ch_fa">Mr. <hi rend="allcaps">Farley</hi>,</actor></castItem> <castItem><role>Pietro,</role> <actor>Mr. <hi rend="allcaps">Sarjant</hi>,</actor></castItem> <castItem><role>Luigi,</role> <actor>Mr. <hi rend="allcaps">Heath</hi>,</actor></castItem> <castItem><role>Sailor,</role> <actor>Mr. <hi rend="allcaps">Powers</hi>,</actor></castItem>
                  <castItem><role>Olivia,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem> <castItem><role>Viola,</role> <actor ref="namedentities.xml#sa_bo">Miss <hi rend="allcaps">S. Booth</hi>,</actor></castItem> <castItem><role>Maria,</role> <actor ref="namedentities.xml#ma_gi">Mrs. <hi rend="allcaps">Gibbs</hi></actor></castItem><lb/>
               </castList>
               To which will be added, <hi rend="italic">for the second time</hi>, the <hi rend="allcaps">Grand Dramatick Romance</hi> of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
                  <title type="sub"><hi rend="allcaps">Or</hi>,<lb/>
                     <hi rend="italic">Female Curiosity.</hi></title></bibl><lb/>
               <hi rend="italic">With entirely new Scenes, Machinery, Dresses and Decorations.</hi><lb/>
               <hi rend="italic">The Musick composed and selected by <persName ref="namedentities.xml#mi_ke">Mr. <hi rend="allcaps">Kelly</hi></persName>.</hi><lb/>
               <castList>
                  <castItem><role>Abomelique,</role> <actor>Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Ibrahim,</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons</hi>,</actor></castItem><lb/>
                  <castItem><role>Selim,</role> <actor>Mr. <hi rend="allcaps">Taylor</hi>,</actor></castItem><lb/>
                  <castItem><role>Shacabac,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem><lb/>
                  <castItem><role>Hassan,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem><lb/>
                  <castItem><role>Fatima,</role> <actor>Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>Irene,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Beda,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic"><hi rend="allcaps">Spahis</hi></hi>,</role><lb/>
                     Mess. <actor>Treby,</actor> <actor>King,</actor> <actor>Bishop,</actor> <actor>Hickman,</actor> <actor>Droset,</actor> <actor>Norris,</actor> <actor>Tinney,</actor> <actor>Crossman,</actor><lb/>
                     <actor>Davies,</actor> <actor>Makeen,</actor> <actor>P. Taylor,</actor> &amp;c. &amp;c.<lb/></castItem>
                  <castItem><role><hi rend="allcaps"><hi rend="italic">Janizaries</hi></hi>,</role><lb/>
                     Mess. <actor>I. Bellamy,</actor> <actor>Bond,</actor> <actor>Dixon,</actor> <actor>Everard,</actor> <actor>Fairclough,</actor> <actor>Lee,</actor> <actor>Limon,</actor> <actor>Montague,</actor> <actor ref="namedentities.xml#jo_no">Norman,</actor> <actor ref="namedentities.xml#ja_st">Street</actor><lb/>
                     <actor>Taylor,</actor> <actor>Terry,</actor> <actor ref="namedentities.xml#jo_te">Tett,</actor> <actor>Williams,</actor></castItem>
                  <castItem><role><hi rend="allcaps"><hi rend="allcaps">Peasants</hi></hi>,</role><lb/>
                     Mesdames <actor ref="namedentities.xml#el_co">Coates,</actor> <actor>Findlay,</actor> <actor>Grimaldi,</actor> <actor>Hardy,</actor> <actor>Iliff,</actor> <actor>Johnson,</actor> <actor>Price,</actor> <actor ref="namedentities.xml#h_wh">Whitmore</actor>,<lb/></castItem>
                 </castList>
               <hi rend="italic">The Dances by</hi><lb/>
               <persName ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi></persName>,<lb/>
               Mess. <persName>Brown</persName>, <persName>Gaywood</persName>, <persName>Grant</persName>, <persName>Heath</persName>, <persName>Louis</persName>, <persName ref="namedentities.xml#mr_pl">Platt</persName>, <persName>Powers</persName>, <persName>Sarjant</persName>,<lb/>
               Mesdames <persName>Bologna</persName>, <persName>I. Bologna</persName>, <persName>Cox</persName>, <persName>Heath</persName>, <persName>Louis</persName>, <persName>Ryall</persName>, <persName>Standen</persName>, <persName>Watts</persName>.<lb/>
               Scenes painted by <hi rend="italic">Mess. <persName ref="namedentities.xml#th_ph_scenes">Phillips</persName>, <persName ref="namedentities.xml#sa_wh">Whitmore</persName>, <persName ref="namedentities.xml#ch_jo_pu">Pugh</persName>, <persName ref="namedentities.xml#jo_he_gr">Grieve</persName>, <persName ref="namedentities.xml#ch_ho">Hollogan</persName>, <persName ref="namedentities.xml#mr_ho">Hodgins</persName>,</hi> &amp; their assistants<lb/>
               <hi rend="italic">The Machinery by Mess. Saul and Bradwell. The Decorations by Mr. Bradwell.</hi><lb/>
               The Dresses by Mr. Flowers and Miss Egan.<lb/>
               Vivant Rex &amp; Regina.</ab>
         </div>
