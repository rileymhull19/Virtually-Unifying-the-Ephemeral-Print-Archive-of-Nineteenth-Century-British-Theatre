  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><hi rend="allcaps">Third Time.</hi><lb/>
               <hi rend="allcaps">The Third Night of</hi><lb/>
               <persName ref="namedentities.xml#jo_br">Mr. <hi rend="allcaps">Braham</hi>'s</persName> Engagement.<lb/>
               <placeName ref="namedentities.xml#lyceum"><hi rend="allcaps"><hi rend="italic">Theatre Royal, Lyceum.</hi></hi></placeName><lb/>
               This present <hi rend="allcaps">Friday</hi>, <date when="1812-05-08"><hi rend="allcaps">May</hi> 8, 1812</date>,<lb/>
               Their Majesties Servants will perform a <hi rend="smallcaps">New Grand Opera Romance</hi> in Three Acts,<lb/>
               to be called The<lb/>
               <bibl><title ref="namedentities.xml#play_devils_bridge">Devil's Bridge.</title></bibl><lb/>
               With entirely New <hi rend="italic">Music, Scenery, Dresses, and Decoration.</hi><lb/>
               The <hi rend="allcaps">Music</hi> composed by <persName ref="namedentities.xml#jo_br">Mr. <hi rend="allcaps">Braham</hi></persName> and <persName ref="namedentities.xml#ch_ed_ho">Mr. <hi rend="allcaps">Horn</hi></persName>.<lb/>
               The <hi rend="allcaps">Overture</hi> by <persName ref="namedentities.xml#ch_ed_ho">Mr. <hi rend="allcaps">Horn</hi></persName>.<lb/>
               <castList>
                  <head><hi rend="italic">The Principal Characters by</hi></head><lb/>
                  <castItem><actor ref="namedentities.xml#jo_br">Mr. <hi rend="allcaps">Braham</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#ja_ra">Mr. <hi rend="allcaps">Raymond</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#wi_lo">Mr. <hi rend="allcaps">Lovegrove</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#th_ma">Mr. <hi rend="allcaps">Marshall</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#vi_de">Mr. <hi rend="allcaps">De Camp</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_waldegrave">Mr. <hi rend="allcaps">Waldegrave</hi>,</actor></castItem><lb/>
                  <castItem><actor>Mr. <hi rend="allcaps">Ray</hi>,</actor></castItem><lb/>
                  <castItem><actor>Mr. <hi rend="allcaps">Miller</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#wi_ox">Mr. <hi rend="allcaps">Oxberry</hi>,</actor></castItem><lb/>
                  <castItem><actor>A Young Gentleman<hi rend="allcaps"></hi>,</actor><lb/>
                     <hi rend="italic">(Being His 3rd Appearance on any Stage.)</hi></castItem><lb/>
                  <castItem><actor>Miss <hi rend="allcaps">Brereton</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#ma_di">Mrs. <hi rend="allcaps">Dickons</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#ma_bl">Mrs. <hi rend="allcaps">Bland</hi>,</actor></castItem><lb/>
                  <castItem><actor>Miss <hi rend="allcaps">Kelly</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Chorus of Soldiers and Peasants.</hi></role><lb/>
                     Messrs. <actor ref="namedentities.xml#ch_da">Danby,</actor> <actor ref="namedentities.xml#jo_ca">Caulfield,</actor> <actor>Cook,</actor> <actor>Wilson,</actor> <actor ref="namedentities.xml#mr_me">Mead,</actor> <actor>Jones,</actor> <actor ref="namedentities.xml#ro_di">Dibble,</actor> <actor>Whilmshurst.</actor><lb/>
                     <actor>Hope,</actor> <actor ref="namedentities.xml#ch_ma">Mathews,</actor> <actor ref="namedentities.xml#mr_go">Goodman,</actor> <actor ref="namedentities.xml#j_we">Wells,</actor> <actor>Gussio,</actor> <actor>Rials,</actor> &amp;c. &amp;c.<lb/>
                     Messrs. <actor ref="namedentities.xml#ro_ch">Chatterley,</actor> <actor ref="namedentities.xml#mo_me">Menage,</actor> <actor ref="namedentities.xml#jo_ca">Caulfield,</actor> <actor ref="namedentities.xml#mr_mi">Minton,</actor> <actor>I. Boyce,</actor> <actor>Jones,</actor><lb/>
                     <actor ref="namedentities.xml#j_we">Wells,</actor> <actor>Barrat,</actor> &amp;c. &amp;c.</castItem><lb/>
               </castList>
               The <hi rend="allcaps">Scenery</hi> designed and executed by <persName ref="namedentities.xml#th_gr">Mr. <hi rend="allcaps">Greenwood</hi></persName> and assistants.<lb/>
               The <hi rend="allcaps">Machinery</hi> by <persName ref="namedentities.xml#wi_un">Mr. <hi rend="allcaps">Underwood</hi></persName> and assistants.<lb/>
               The <hi rend="allcaps">Dresses</hi> by <persName ref="namedentities.xml#he_ba">Mr. <hi rend="allcaps">Banks</hi></persName>, <persName ref="namedentities.xml#ma_re">Miss <hi rend="allcaps">Rein</hi></persName>, and their assistants.<lb/>
               Books of the Songs may be had in the Theatre, and at <hi rend="allcaps">Barker's</hi> Dramatic Repsoitory,<lb/>
               Great Russell Street.<lb/>
               To which will be added the Farce of The<lb/>
               <bibl><title ref="namedentities.xml#play_midnight_hour">Midnight Hour.</title></bibl><lb/>
               <castList>
                  <castItem><role>The Marquis,</role> <actor ref="namedentities.xml#vi_de">Mr. <hi rend="allcaps">De Camp</hi>,</actor></castItem> <castItem><role>The General,</role> <actor ref="namedentities.xml#mr_penson">Mr. <hi rend="allcaps">Penson</hi>,</actor></castItem><lb/>
                  <castItem><role>Sebastian,</role> <actor ref="namedentities.xml#wi_ox">Mr. <hi rend="allcaps">Oxberry</hi>,</actor></castItem> <castItem><role>Nicholas,</role> <actor>Mr. <hi rend="allcaps">Penley</hi>,</actor></castItem><lb/>
                  <castItem><role>Mathias,</role> <actor ref="namedentities.xml#ro_pa">Mr. <hi rend="allcaps">Palmer</hi>,</actor></castItem> <castItem><role>Ambrose,</role> <actor ref="namedentities.xml#ra_we">Mr. <hi rend="allcaps">Wewitzer</hi>,</actor></castItem><lb/>
                  <castItem><role>Julia,</role> <actor ref="namedentities.xml#ma_an_or">Mrs. <hi rend="allcaps">Orger</hi>,</actor></castItem> <castItem><role>Cicely,</role> <actor ref="namedentities.xml#ch_ti">Miss <hi rend="allcaps">Tidswell</hi>,</actor></castItem><lb/>
                  <castItem><role>Flora,</role> <actor ref="namedentities.xml#el_ed">Mrs. <hi rend="allcaps">Edwin</hi>,</actor></castItem><lb/>
               </castList>
               <hi rend="italic">Vivant Rex et Regina!-No Money to be Returned.</hi></ab>
         </div>
