  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab>Second Time.<lb/>
               <placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">New Theatre Royal, Covent-Garden,</hi></placeName><lb/>
               This present <hi rend="allcaps">Wednesday</hi>, <date rend="1811-04-24">April 24, 1811</date>,<lb/>
               Will be performed, a <hi rend="allcaps">New Comedy</hi>, in five acts, called The<lb/>
               <bibl><title ref="namedentities.xml#play_gazette_extraordinary">Gazette Extraordinary.</title></bibl><lb/>
               <castList>
                  <head><hi rend="italic">The principal Characters by</hi></head><lb/>
                  <castItem><actor ref="namedentities.xml#mr_young">Mr. <hi rend="allcaps">Young</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_jones">Mr. <hi rend="allcaps">Jones</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#jo_sh_mu">Mr. <hi rend="allcaps">Munden</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#ch_mu">Mr. <hi rend="allcaps">Murray</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_hamerton">Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_bishop">Mr. <hi rend="allcaps">Bishop</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mrs_weston">Mrs. <hi rend="allcaps">Weston</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#na_jo">Mrs. <hi rend="allcaps">H. Johnston</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#miss_bolton">Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#ma_an_da">Mrs. <hi rend="allcaps">Davenport</hi>,</actor></castItem> <castItem><actor ref="sa_bo">Miss <hi rend="allcaps">S. Booth</hi>,</actor></castItem><lb/>
               </castList>
               The <hi rend="allcaps">Prologue</hi> and <hi rend="allcaps">Epilogue</hi> to be spoken by <persName ref="namedentities.xml#mr_brunton">Mr. <hi rend="allcaps">Brunton</hi></persName> and <persName ref="namedentities.xml#sa_bo">Miss <hi rend="allcaps">S. Booth.</hi></persName><lb/>
               After which (for the 39th and Last Night but Two)<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
                  <title type="sub"><hi rend="italic">Or, Female Curiosity.</hi></title></bibl><lb/>
               <castList>
                  <castItem><role>Abomelique,</role> <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Ibrahim,</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons</hi>,</actor></castItem> <castItem><role>Selim,</role> <actor ref="namedentities.xml#mr_taylor">Mr. <hi rend="allcaps">Taylor</hi>,</actor></castItem><lb/>
                  <castItem><role>Shacabac,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><role>Hassan,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem><lb/>
                  <castItem><role>Fatima,</role> <actor ref="namedentities.xml#miss_bolton">Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem> <castItem><role>Irene,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem> <castItem><role>Beda,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
               </castList> 
               <hi rend="italic">The Dances by</hi> <persName ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi></persName>,<lb/>
               Mesdames <persName ref="namedentities.xml#mrs_bologna">Bologna</persName>, <persName ref="namedentities.xml#mrs_i_bologna">I. Bologna</persName>, <persName ref="namedentities.xml#mrs_cox">Cox</persName>, <persName ref="namedentities.xml#mrs_heath">Heath</persName>, <persName ref="namedentities.xml#mrs_louis">Louis</persName>, <persName ref="namedentities.xml#mrs_ryall">Ryall</persName>, <persName ref="namedentities.xml#mrs_standen">Standen</persName>, <persName ref="namedentities.xml#mrs_watts">Watts</persName>.<lb/>
              <hi rend="allcaps">Vivant Rex &amp; Regina</hi>.<lb/>
               The new Comedy called The Gazette Extraordinary,<lb/>
               having been received throughout with universal applause, will be repeated<lb/>
               Tomorrow and Friday.</ab>
         </div>
      </body>
  </text>
