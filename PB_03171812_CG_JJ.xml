  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">Theatre Royal, Covent Garden</hi></placeName><lb/>
               This present <hi rend="allcaps">Tuesday</hi>, <date when="1812-03-17">March 17, 1812</date>.<lb/>
               Will be acted (<hi rend="italic">6th time</hi>) <hi rend="italic">Shakspeare's</hi> Tragedy of<lb/>
               <bibl><title ref="namedentities.xml#play_julius_caesar">Julius Caesar.</title></bibl><lb/>
               <hi rend="italic">(The Dresses, Scenes and Decorations are, for the greater part, entirely new.)</hi><lb/>
               <hi rend="italic">The Overture and Act-Symphonies composed by Mr. <hi rend="allcaps">Ware</hi></hi>.<lb/>
               <castList>
                  <castItem><role>Julius Caesar</role> by <actor ref="namedentities.xml#da_eg">Mr. <hi rend="allcaps">Egerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Octavius Caesar</role> by <actor>Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Marc Antony</role> by <actor ref="namedentities.xml#ch_ke">Mr. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Lepidus</role> by <actor ref="namedentities.xml#ch_mu">Mr. <hi rend="allcaps">Murray</hi>,</actor></castItem><lb/>
                  <castItem><role>Brutus</role> by <actor ref="namedentities.xml#jo_ph_ke">Mr. <hi rend="allcaps">Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Cassius</role> by <actor>Mr. <hi rend="allcaps">Young</hi>,</actor></castItem><lb/>
                  <castItem><role>Casca</role> by <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem><lb/>
                  <castItem><role>Trebonius</role> by <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Dedius</role> by <actor>Mr. <hi rend="allcaps">Brunton</hi>,</actor></castItem> <castItem><role>Metellus</role> by <actor>Mr. <hi rend="allcaps">Creswell</hi>,</actor></castItem><lb/>
                  <castItem><role>Cinna</role> by <actor>Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><role>Popilius Loenas</role> by <actor>Mr. <hi rend="allcaps">Norris</hi>,</actor></castItem><lb/>
                  <castItem><role>Titinius</role> by <actor>Mr. <hi rend="allcaps">Claremont</hi>,</actor></castItem> <castItem><role>Soothsayer</role> by <actor>Mr. <hi rend="allcaps">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><role>Flavius</role> by <actor>Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem> <castItem><role>Servius</role> by <actor>Mr. <hi rend="allcaps">Treby</hi>,</actor></castItem> <castItem><role>Strato</role> by <actor>Mr. <hi rend="allcaps">Bishop</hi>,</actor></castItem><lb/>
                  <castItem><role>Clitus,</role> <actor ref="namedentities.xml#wi_we">Mr. West,</actor></castItem> <castItem><role>Lucius,</role> <actor ref="namedentities.xml#fr_me">Mr. Menage,</actor></castItem> <castItem><role>Varro,</role> <actor>Mr. Huckel,</actor></castItem> <castItem><role>Pindarus,</role> <actor>Mr. Duruset,</actor></castItem><lb/>
                  <castItem><role>Plebeians,</role> Mess. <actor ref="namedentities.xml#wi_at"><hi rend="smallcaps">Atkins,</hi></actor> <actor ref="namedentities.xml#sa_si"><hi rend="smallcaps">Simmons,</hi></actor> <actor ref="namedentities.xml#mr_ho"><hi rend="smallcaps">Howell,</hi></actor> <actor><hi rend="smallcaps">Truman,</hi></actor><lb/>
                     <actor ref="namedentities.xml#mr_banks">Banks,</actor> <actor>Brown,</actor> <actor>Goodwin,</actor> <actor>Grant,</actor> <actor>Griffiths,</actor> <actor>W, Griffiths,</actor> <actor>Heath,</actor> <actor>Hickman,</actor> <actor>Jeffkins,</actor><lb/>
                     <actor>Lee,</actor> <actor>Louis,</actor> <actor>Montague,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor>Powers,</actor> <actor>Sarjant,</actor> <actor>Williams,</actor> <actor>Yarnold</actor><lb/>
                     <actor>Bradwell,</actor> <actor>Chapman,</actor> <actor>W. Goodwin,</actor> <actor>Ladbrook,</actor> <actor>Morelli,</actor> <actor>Wilson.</actor></castItem><lb/>
                  <castItem><role>Calpurnia</role> by <actor>Mrs. <hi rend="allcaps">Weston</hi>,</actor></castItem><lb/>
                  <castItem><role>Procia</role> by <actor ref="namedentities.xml#ja_po">Mrs. <hi rend="allcaps">Powell</hi>,</actor></castItem><lb/>
                  <castItem><role>Matrons,</role> Mesdames <actor>Bologna,</actor> <actor ref="namedentities.xml#el_co">Coates,</actor> <actor>Grimaldi,</actor> <actor>Hardy,</actor></castItem><lb/>
                  <castItem><role>Virgins,</role> Mesdames. <actor>I. Bologna,</actor> <actor>Cox,</actor> <actor>Findlay,</actor> <actor>Heath,</actor> <actor>Ryall,</actor> <actor>Standen.</actor></castItem><lb/>
               </castList>
               The Play of <hi rend="italic">Julius Caesar</hi> is printed conformably to the representation, and<lb/>
               will be to be had [<hi rend="italic">only at the Theatre</hi>] this Evening.<lb/>
               To which will be added a Farce called<lb/>
               <bibl><title ref="namedentities.xml#play_is_he_a_prince"><hi rend="allcaps">Is He a Prince?</hi></title></bibl><lb/>
               <castList>
                  <castItem><role>Baron Crackenberg,</role> <actor ref="namedentities.xml#jo_em">Mr. <hi rend="allcaps">Emery</hi>,</actor></castItem> <castItem><role>Count Rosenblum,</role> <actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><role>Mr. Blussberg,</role> <actor ref="namedentities.xml#wi_bl">Mr. <hi rend="allcaps">Blanchard</hi>,</actor></castItem> <castItem><role>Capt. Lindorf,</role> <actor>Mr. <hi rend="allcaps">Jones</hi>,</actor></castItem><lb/>
                  <castItem><role>Moritz,</role> <actor ref="namedentities.xml#ch_fa">Mr. <hi rend="allcaps">Farley</hi>,</actor></castItem> <castItem><role>Frantz,</role> <actor>Mr. <hi rend="allcaps">Bishop</hi>,</actor></castItem><lb/>
                  <castItem><role>Servants,</role> Mess. <actor>Brown,</actor> <actor>Grant,</actor> <actor>Heath,</actor> <actor>Yarnold</actor></castItem><lb/>
                  <castItem><role>Miss Crackenberg,</role> <actor ref="namedentities.xml#ma_an_da">Mrs. <hi rend="allcaps">Davenport</hi>,</actor></castItem> <castItem><role>Caroline,</role> <actor ref="namedentities.xml#sa_bo">Miss <hi rend="allcaps">S. Booth</hi>,</actor></castItem><lb/>
               </castList>
               <hi rend="italic">The Publick are respectfully informed that, till further notice, Places can<lb/>
                  only be taken from <time when="10:00:00">Ten o'Clock</time>, till <time when="15:30:00">Half past Three</time>.<lb/>
                  No <hi rend="allcaps">Orders</hi> can possibly be admitted.</hi><lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina</hi></ab>
         </div>
      </body>
