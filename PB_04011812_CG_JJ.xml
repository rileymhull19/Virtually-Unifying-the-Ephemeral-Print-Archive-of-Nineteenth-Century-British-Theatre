         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">Theatre Royal, Covent Garden</hi></placeName><lb/>
               This present <hi rend="allcaps">Wednesday</hi>, <date when="1812-04-01">April 1, 1812</date>.<lb/>
               Will be acted (<hi rend="italic">8th time</hi>) <persName ref="namedentities.xml#wi_sha"><hi rend="italic">Shakspeare's</hi></persName> Tragedy of<lb/>
               <bibl><title ref="namedentities.xml#play_julius_caesar">Julius Caesar.</title></bibl><lb/>
               <hi rend="italic">(The Dresses, Scenes and Decorations are, for the greater part, entirely new.)</hi><lb/>
               <hi rend="italic">The Overture and Act-Symphonies composed by Mr. <hi rend="allcaps">Ware</hi></hi>.<lb/>
               <castList>
                  <castItem><role>Julius Caesar</role> by <actor ref="namedentities.xml#da_eg">Mr. <hi rend="allcaps">Egerton</hi>,</actor></castItem> <castItem><role>Octavius Caesar</role> by <actor ref="namedentities.xml#mr_hamerton">Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Marc Antony</role> by <actor ref="namedentities.xml#ch_ke">Mr. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem> <castItem><role>Lepidus</role> by <actor ref="namedentities.xml#ch_mu">Mr. <hi rend="allcaps">Murray</hi>,</actor></castItem><lb/>
                  <castItem><role>Brutus</role> by <actor ref="namedentities.xml#jo_ph_ke">Mr. <hi rend="allcaps">Kemble</hi>,</actor></castItem> <castItem><role>Cassius</role> by <actor ref="namedentities.xml#mr_young">Mr. <hi rend="allcaps">Young</hi>,</actor></castItem><lb/>
                  <castItem><role>Casca</role> by <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><role>Trebonius</role> by <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Dedius</role> by <actor ref="namedentities.xml#mr_brunton">Mr. <hi rend="allcaps">Brunton</hi>,</actor></castItem> <castItem><role>Metellus</role> by <actor ref="namedentities.xml#mr_creswell">Mr. <hi rend="allcaps">Creswell</hi>,</actor></castItem><lb/>
                  <castItem><role>Cinna</role> by <actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><role>Popilius Loenas</role> by <actor ref="namedentities.xml#mr_Norris">Mr. <hi rend="allcaps">Norris</hi>,</actor></castItem><lb/>
                  <castItem><role>Titinius</role> by <actor ref="namedentities.xml#mr_claremont">Mr. <hi rend="allcaps">Claremont</hi>,</actor></castItem> <castItem><role>Soothsayer</role> by <actor ref="namedentities.xml#mr_chapman">Mr. <hi rend="allcaps">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><role>Flavius</role> by <actor ref="namedentities.xml#mr_jefferies">Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem> <castItem><role>Servius</role> by <actor ref="namedentities.xml#mr_treby">Mr. <hi rend="allcaps">Treby</hi>,</actor></castItem> <castItem><role>Strato</role> by <actor ref="namedentities.xml#mr_bishop">Mr. <hi rend="allcaps">Bishop</hi>,</actor></castItem><lb/>
                  <castItem><role>Clitus,</role> <actor ref="namedentities.xml#wi_we">Mr. West,</actor></castItem> <castItem><role>Lucius,</role> <actor ref="namedentities.xml#fr_me">Mr. Menage,</actor></castItem> <castItem><role>Varro,</role> <actor ref="namedentities.xml#mr_huckel">Mr. Huckel,</actor></castItem> <castItem><role>Pindarus,</role> <actor ref="namedentities.xml#mr_duruset">Mr. Duruset,</actor></castItem><lb/>
                  <castItem><role>Plebeians,</role> Mess. <actor ref="namedentities.xml#wi_at"><hi rend="smallcaps">Atkins,</hi></actor> <actor ref="namedentities.xml#sa_si"><hi rend="smallcaps">Simmons,</hi></actor> <actor ref="namedentities.xml#mr_howell"><hi rend="smallcaps">Howell,</hi></actor> <actor ref="namedentities.xml#mr_truman"><hi rend="smallcaps">Truman,</hi></actor><lb/>
                     <actor ref="namedentities.xml#mr_banks">Banks,</actor> <actor ref="namedentities.xml#mr_brown">Brown,</actor> <actor ref="namedentities.xml#mr_goodwin">Goodwin,</actor> <actor ref="namedentities.xml#mr_grant">Grant,</actor> <actor ref="namedentities.xml#mr_griffiths">Griffiths,</actor> <actor ref="namedentities.xml#mr_w_griffiths">W. Griffiths,</actor> <actor ref="namedentities.xml#mr_heath">Heath,</actor> <actor ref="namedentities.xml#mr_hickman">Hickman,</actor> <actor ref="namedentities.xml#mr_jeffkins">Jeffkins,</actor><lb/>
                     <actor ref="namedentities.xml#mr_lee">Lee,</actor> <actor ref="namedentities.xml#mr_louis">Louis,</actor> <actor ref="namedentities.xml#mr_montague">Montague,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor ref="namedentities.xml#mr_powers">Powers,</actor> <actor ref="namedentities.xml#mr_sarjant">Sarjant,</actor> <actor ref="namedentities.xml#mr_williams">Williams,</actor> <actor ref="namedentities.xml#mr_yarnold">Yarnold</actor><lb/>
                     <actor ref="namedentities.xml#mr_bradwell">Bradwell,</actor> <actor ref="namedentities.xml#mr_chapman">Chapman,</actor> <actor ref="namedentities.xml#mr_w_goodwin">W. Goodwin,</actor> <actor ref="namedentities.xml#mr_ladbrook">Ladbrook,</actor> <actor ref="namedentities.xml#mr_morelli">Morelli,</actor> <actor ref="namedentities.xml#mr_wilson">Wilson.</actor></castItem><lb/>
                  <castItem><role>Calpurnia</role> by <actor ref="namedentities.xml#mrs_weston">Mrs. <hi rend="allcaps">Weston</hi>,</actor></castItem> <castItem><role>Procia</role> by <actor ref="namedentities.xml#ja_po">Mrs. <hi rend="allcaps">Powell</hi>,</actor></castItem><lb/>
                  <castItem><role>Matrons,</role> Mesdames <actor ref="namedentities.xml#mrs_bologna">Bologna,</actor> <actor ref="namedentities.xml#el_co">Coates,</actor> <actor ref="namedentities.xml#mr_grimaldi">Grimaldi,</actor> <actor ref="namedentities.xml#mr_hardy">Hardy,</actor></castItem><lb/>
                  <castItem><role>Virgins,</role> Mesdames. <actor ref="namedentities.xml#mrs_i_bologna">I. Bologna,</actor> <actor ref="namedentities.xml#mrs_cox">Cox,</actor> <actor ref="namedentities.xml#mrs_findlay">Findlay,</actor> <actor ref="namedentities.xml#mrs_heath">Heath,</actor> <actor ref="namedentities.xml#mrs_ryall">Ryall,</actor> <actor ref="namedentities.xml#mrs_standen">Standen.</actor></castItem><lb/>
               </castList>
               The Play of <hi rend="italic">Julius Caesar</hi> is printed conformably to the representation, and<lb/>
               will be to be had [<hi rend="italic">only at the Theatre</hi>] this Evening.<lb/>
               To which will be added a Burletta called<lb/>
               <bibl><title ref="namedentities.xml#play_tom_thumb"><hi rend="allcaps">Tom Thumb</hi> the <hi rend="allcaps">Great</hi>.</title></bibl><lb/>
               <castList>
                  <castItem><role>King Arthur,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><role>Tom Thumb</role> by <actor ref="namedentities.xml#mr_chapman">Master <hi rend="allcaps">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><role>Merlin,</role> <actor ref="namedentities.xml#mr_jefferies">Mr. Jefferies,</actor></castItem> <castItem><role>Ghost of Gaffer Thumb,</role> <actor ref="namedentities.xml#ja_st">Mr. Street,</actor></castItem><lb/>
                  <castItem><role>Lord Grizzle,</role> <actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi>,</actor></castItem> <castItem><role>Noodle,</role> <actor ref="namedentities.xml#mr_taylor">Mr. <hi rend="allcaps">Taylor</hi>,</actor></castItem> <castItem><role>Doodle,</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Lords in Waiting-</hi></role> Mess. <actor ref="namedentities.xml#mr_brown">Brown,</actor> <actor ref="namedentities.xml#mr_grant">Grant,</actor> <actor ref="namedentities.xml#mr_heath">Heath,</actor> <actor ref="namedentities.xml#mr_louis">Louis,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor ref="namedentities.xml#mr_powers">Powers,</actor> <actor ref="namedentities.xml#mr_sarjant">Sarjant,</actor> <actor ref="namedentities.xml#mr_yarnold">Yarnold</actor></castItem><lb/>
                  <castItem><role>Queen Dollalolla,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem> <castItem><role>Princess Huncamunca,</role> <actor ref="namedentities.xml#miss_e_bolton">Miss <hi rend="allcaps">E. Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>Glumdalca,</role> <actor ref="namedentities.xml#an_ma_le">Miss Leserve,</actor></castItem> <castItem><role>Frizalta,</role> <actor ref="namedentities.xml#h_wh">Mrs. <hi rend="allcaps">Whitmore,</hi>,</actor></castItem> <castItem><role>Plumante,</role> <actor ref="namedentities.xml#miss_cox">Miss Cox,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Ladies in Waiting-</hi></role> Mesdames. <actor ref="namedentities.xml#mrs_i_bologna">I. Bologna,</actor> <actor ref="namedentities.xml#mrs_findlay">Findlay,</actor> <actor ref="namedentities.xml#mrs_heath">Heath,</actor> <actor ref="namedentities.xml#mrs_standen">Standen.</actor></castItem><lb/>
               </castList>
               <hi rend="italic">The Publick are respectfully informed that, till further notice, Places can<lb/>
                  only be taken from <time when="10:00:00">Ten o'Clock</time>, till <time when="15:30:00">Half past Three</time>.<lb/>
                  No <hi rend="allcaps">Orders</hi> can possibly be admitted.</hi><lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina</hi></ab>
