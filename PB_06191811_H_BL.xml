               <bibl><title type="main">The <hi rend="allcaps">Poor Sailor</hi>;</title><lb/>
               <title type="sub"><hi rend="italic">Or, Little <hi rend="allcaps">Bob</hi> and Little <hi rend="allcaps">Ben</hi>.</hi></title></bibl><lb/>
