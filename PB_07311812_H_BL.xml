               <hi rend="italic">A New Comedy in Three Acts, call'd The</hi><lb/>
               <bibl><title>Fortune-Hunters.</title></bibl><lb/>
               <castList>
                  <head>The Principal Characters by</head><lb/>
                  <castItem><actor>Mr. <hi rend="allcaps">Jones</hi>.</actor></castItem><lb/>
                  <castItem><actor>Mr. <hi rend="allcaps">Kent</hi>.</actor></castItem><lb/>
                  <castItem><actor>Mr. <hi rend="allcaps">Betterton,</hi> Jun.</actor></castItem><lb/>
                  <castItem><actor>Mr. <hi rend="allcaps">Eyre</hi>.</actor></castItem><lb/>
