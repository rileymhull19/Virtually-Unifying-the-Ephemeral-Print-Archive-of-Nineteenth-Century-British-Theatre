  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#haymarket">Theatre-Royal, Hay-Market</placeName>.<lb/>
               This <hi rend="allcaps">Evening</hi>, <date when="1811-07-10"><hi rend="allcaps">Wednesday</hi> July 10, 1811.</date><lb/>
               Will be Perform'd (<hi rend="italic">Fifth time this Season</hi>) the Play of The<lb/>
               <bibl><title ref="namedentities.xml#play_iron_chest">Iron Chest.</title></bibl><lb/>
               The Musick Composed by the late <persName ref="namedentities.xml#st_jo_se_st">Mr. Storace</persName>.<lb/>
               <castList>
                  <castItem><role>Sir Edward Mortimer,</role> <actor ref="namedentities.xml#ro_wi_el">Mr. <hi rend="allcaps">Elliston</hi>.</actor></castItem><lb/>
                  <castItem><role>Fitzharding,</role> <actor ref="namedentities.xml#ed_ey">Mr. <hi rend="allcaps">Eyre</hi>.</actor></castItem><lb/>
                  <castItem><role>Wilford,</role> <actor ref="namedentities.xml#mr_gomersall">Mr. <hi rend="allcaps">Gomersall</hi>.</actor><lb/>
                     (His second appearance on this Stage)</castItem><lb/>
                  <castItem><role>Adam Winterton,</role> <actor ref="namedentities.xml#mr_barnes">Mr. <hi rend="allcaps">Barnes</hi>.</actor></castItem><lb/>
                  <castItem><role>Rawbold,</role> <actor ref="namedentities.xml#mr_martin">Mr. <hi rend="allcaps">Martin</hi>.</actor></castItem><lb/>
                  <castItem><role>Samson Rawbold,</role> <actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi>.</actor></castItem><lb/>
                  <castItem><role>Armstrong,</role> <actor ref="namedentities.xml#mr_paine">Mr. <hi rend="allcaps">Paine</hi>.</actor></castItem><lb/>
                  <castItem><role>Orson,</role> <actor ref="namedentities.xml#mr_shaw">Mr. <hi rend="allcaps">Shaw</hi>.</actor></castItem><lb/>
                  <castItem><role>Robbers,</role> Messrs. <actor ref="namedentities.xml#mr_lewes">Lewes,</actor> <actor ref="namedentities.xml#mr_houghton">Houghton,</actor> <actor ref="namedentities.xml#mr_hodson">Hodson,</actor> <actor ref="namedentities.xml#mr_linton">Linton,</actor> &amp;c.</castItem><lb/>
                  <castItem><role>Servants,</role> Messrs. <actor ref="namedentities.xml#mr_mi">Minton,</actor> <actor ref="namedentities.xml#mr_widdicombe">Widdicombe,</actor> &amp;c.</castItem><lb/>
                  <castItem><role>Helen,</role> <actor ref="namedentities.xml#ju_gl">Mrs. <hi rend="allcaps">Glover</hi>.</actor></castItem><lb/>
                  <castItem><role>Blanch,</role> <actor ref="namedentities.xml#ma_gi">Mrs. <hi rend="allcaps">Gibbs</hi>.</actor></castItem><lb/>
                  <castItem><role>Barbara,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>.</actor></castItem><lb/>
                  <castItem><role>Judith,</role> <actor ref="namedentities.xml#miss_wheatley">Miss <hi rend="allcaps">Wheatley</hi>.</actor></castItem><lb/>
                  <castItem><role>Chorus of Robbers, Peasants, &amp;c.</role> Messrs. <actor ref="namedentities.xml#mr_terry">Terry,</actor> <actor ref="namedentities.xml#mr_eames">Eames,</actor> <actor ref="namedentities.xml#mr_griffith">Griffith,</actor><lb/>
                     <actor ref="namedentities.xml#mr_oddwell">Odwell,</actor> <actor ref="namedentities.xml#mr_willoughby">Willoughby,</actor> <actor ref="namedentities.xml#mr_diether">Diether,</actor> <actor ref="namedentities.xml#jo_ca">Caulfield,</actor> <actor ref="namedentities.xml#mr_harrison">Harrison,</actor> <actor ref="namedentities.xml#mr_gray">Gray,</actor> <actor ref="namedentities.xml#mr_sheriff">Sheriff,</actor> &amp;c.</castItem><lb/>
               </castList>
               <hi rend="italic">To which will be added</hi> <hi rend="allcaps">(Sixth Time)</hi> <hi rend="italic"><hi rend="allcaps">A New Farce</hi>, (with Songs,) call'd</hi> The<lb/>
               <bibl><title ref="namedentities.xml#play_outside_passenger">Outside Passenger.</title></bibl><lb/>
               <hi rend="italic">The Musick entirely new, Composed by <persName ref="namedentities.xml#wi_re">Mr. Reeve</persName>, <persName ref="namedentities.xml#mr_whitaker">Mr. Whitaker</persName>, and <persName ref="namedentities.xml#mr_d_corri">Mr. D. Corri</persName>.</hi><lb/>
               <hi rend="italic">The Overture by <persName ref="namedentities.xml#wi_re">Mr. Reeve</persName>.</hi><lb/>
               <castList>
                  <head>The Principal Characters by</head>
                  <castItem><actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#ed_ey">Mr. <hi rend="allcaps">Eyre</hi>.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_grove">Mr. <hi rend="allcaps">Grove</hi>.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_paine">Mr. <hi rend="allcaps">Paine</hi>.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_noble">Mr. Noble.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_finn">Mr. Finn</actor></castItem> <castItem><actor ref="namedentities.xml#mr_lewes">Mr. Lewes.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_mi">Mr. Minton.</actor></castItem> <castItem><actor ref="namedentities.xml#mr_widdicombe">Mr. Widdicombe.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_mallinson">Mr. <hi rend="allcaps">Mallinson</hi>.</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#an_ma_le">Miss <hi rend="allcaps">Leserve</hi>.</actor></castItem> <castItem><actor ref="namedentities.xml#miss_bellchambers">Miss <hi rend="allcaps">Bellchambers</hi>.</actor></castItem><lb/>
                  <castItem>And <actor ref="namedentities.xml#ma_gi">Mrs. <hi rend="allcaps">Gibbs</hi>.</actor></castItem><lb/>
               </castList>
               <hi rend="allcaps">Boxes</hi> <measure type="currency">5s</measure>. <hi rend="allcaps">Pit</hi> <measure type="currency">3s</measure>. <hi rend="allcaps">First Gallery</hi> <measure type="currency">2s</measure>. <hi rend="allcaps">Second Gallery</hi> <measure type="currency">1s</measure>.<lb/>
               The Doors to be Opened at <time when="18:00:00">Six o'Clock</time>, and the Performance to begin at <time when="19:00:00">Seven</time>.<lb/>
               Places for the Boxes to be taken of <persName ref="namedentities.xml#mr_mas">Mr. <hi rend="allcaps">Massingham</hi></persName> at the Theatre.<lb/></ab>
         </div>
