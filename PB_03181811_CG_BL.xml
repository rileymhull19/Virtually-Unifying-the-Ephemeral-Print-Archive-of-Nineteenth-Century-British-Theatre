  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">New Theatre Royal, Covent-Garden,</hi></placeName><lb/>
               This present <hi rend="allcaps">Monday</hi>, <date when="1811-03-18">March 18, 1811</date>, will be acted (3d time) the Historical Play of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_henry_v"><hi rend="allcaps">King Henry</hi> the <hi rend="allcaps">Fifth;</hi></title></bibl><lb/>
               <title type="sub"><hi rend="italic">Or, <hi rend="allcaps">The Conquest of France</hi>.</hi></title><lb/>
               <hi rend="italic">The new Overture and Act-Symphonies composed by Mr. <hi rend="allcaps">Ware</hi>.</hi><lb/>
               <castList>
                  <castItem><role>King Henry the Fifth</role> by <actor ref="namedentities.xml#jo_ph_ke">Mr. <hi rend="allcaps">Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Duke of Gloster,</role> <actor>Mr. <hi rend="italic">Hamerton</hi>,</actor></castItem> <castItem><role>Duke of Bedford,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="italic">Menage</hi>,</actor></castItem><lb/>
                  <castItem><role>Duke of Exeter</role> by <actor ref="namedentities.xml#da_eg">Mr. <hi rend="italic">Egerton</hi>,</actor></castItem> <castItem><role>Earl of Westmoreland</role> by <actor>Mr. <hi rend="italic">Claremont</hi></actor></castItem><lb/>
                  <castItem><role>Archbishop of Canterbury,</role> <actor>Mr. <hi rend="italic">Cresswell</hi>,</actor></castItem> <castItem><role>Bishop of Ely,</role> <actor>Mr. <hi rend="italic">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><role>Earl of Cambridge,</role> <actor>Mr. Norris,</actor></castItem> <castItem><role>Lord Scroop,</role> <actor>Mr. Bishop,</actor></castItem> <castItem><role>Sir Thomas Grey,</role> <actor>Mr. Truman,</actor></castItem><lb/>
                  <castItem><role>Sir T. Erpingham</role> by <actor ref="namedentities.xml#ge_go_da">Mr. <hi rend="italic">Davenport</hi>,</actor></castItem> <castItem><role>Capt. Gower</role> by <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="italic">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Capt. Fluellen,</role> <actor ref="namedentities.xml#wi_bl">Mr. <hi rend="italic">Blanchard</hi>,</actor></castItem> <castItem><role>Williams,</role> <actor ref="namedentities.xml#jo_em">Mr. <hi rend="italic">Emery</hi>,</actor></castItem> <castItem><role>Bates,</role> <actor ref="namedentities.xml#wi_at">Mr. <hi rend="allcaps">Atkins</hi>,</actor></castItem><lb/>
                  <castItem><role>Nym,</role> <actor>Mr. King,</actor></castItem> <castItem><role>Bardolph,</role> <actor>Mr. Williams,</actor></castItem> <castItem><role>Pistol,</role> <actor ref="namedentities.xml#sa_si">Mr. Simmons,</actor></castItem> <castItem><role>Page,</role> <actor>Master Chapman,</actor></castItem><lb/>
                  <castItem><role>Mrs. Quickly</role> by <actor ref="namedentities.xml#ma_an_da">Mrs. <hi rend="italic">Davenport</hi>,</actor></castItem><lb/>
                  <castItem><role>Charles, King of France,</role> by <actor ref="namedentities.xml#ch_mu">Mr. <hi rend="italic">Murray</hi>,</actor></castItem><lb/>
                  <castItem><role>The Dauphin</role> by <actor>Mr. <hi rend="italic">Brunton</hi>,</actor></castItem> <castItem><role>Duke of Burgundy</role> by <actor>Mr. <hi rend="italic">Jefferies</hi>,</actor></castItem><lb/>
                  <castItem><role>Constable of France,</role> <actor>Mr. <hi rend="italic">Field</hi>,</actor></castItem> <castItem><role>Duke of Bourbon,</role> <actor>Mr. <hi rend="italic">Lee</hi>,</actor></castItem><lb/>
                  <castItem><role>Governor of Harfleur,</role> <actor>Mr. <hi rend="italic">Bishop</hi>,</actor></castItem> <castItem><role>Montjoy,</role> <actor>Mr. <hi rend="italic">Treby</hi>,</actor></castItem><lb/>
                  <castItem><role>Isabel, Queen of France,</role> <actor>Mrs. <hi rend="italic">Weston</hi>,</actor></castItem> <castItem><role>Princess Katharine,</role> <actor ref="namedentities.xml#sa_bo">Miss <hi rend="italic">S. Booth</hi>,</actor></castItem><lb/>
               </castList>
               To which will be added, <hi rend="italic">for the 19th time</hi>, the <hi rend="allcaps">Grand Dramatick Romance</hi> of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
                  <title type="sub"><hi rend="italic">Or,Female Curiosity.</hi></title></bibl><lb/>
               <hi rend="italic">The Musick composed by <persName ref="namedentities.xml#mi_ke">Mr. <hi rend="allcaps">Kelly</hi></persName>.</hi><lb/>
               <castList>
                  <castItem><role>Abomelique,</role> <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Ibrahim,</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons</hi>,</actor></castItem> <castItem><role>Selim,</role> <actor>Mr. <hi rend="allcaps">Taylor</hi>,</actor></castItem><lb/>
                  <castItem><role>Shacabac,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><role>Hassan,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem><lb/>
                  <castItem><role>Fatima,</role> <actor>Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>Irene,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Beda,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">Spahis</hi>,</role> Mess. <actor>Treby,</actor> <actor>King,</actor> <actor>Bishop,</actor> <actor>Hickman,</actor> <actor>Droset,</actor> <actor>Norris,</actor> <actor>Tinney,</actor> <actor>Crossman,</actor><lb/>
                     <actor>Davies,</actor> <actor>Makeen,</actor> &amp;c. &amp;c.</castItem><lb/>
                  <castItem><role><hi rend="italic">Janizaries</hi>,</role> Mess. <actor>I. Bellamy,</actor> <actor ref="namedentities.xml#mr_bond">Bond,</actor> <actor>Dixon,</actor> <actor>Everard,</actor> <actor>Fairclough,</actor> <actor>Lee,</actor> <actor>Linton,</actor> <actor>Montague,</actor> <actor ref="namedentities.xml#jo_no">Norman,</actor> <actor ref="namedentities.xml#ja_st">Street</actor><lb/>
                     <actor>J. Taylor,</actor> <actor>Terry,</actor> <actor ref="namedentities.xml#jo_te">Tett,</actor> <actor>Williams,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Peasants</hi>,</role>Mesdames <actor ref="namedentities.xml#el_co">Coates,</actor> <actor>Findlay,</actor> <actor>Grimaldi,</actor> <actor>Hardy,</actor> <actor>Iliff,</actor> <actor>Johnson,</actor> <actor>Price,</actor> <actor ref="namedentities.xml#h_wh">Whitmore</actor>,</castItem><lb/>
               </castList>
               <hi rend="italic">The Dances by</hi><lb/>
               <persName ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi></persName>,<lb/>
               Mess. <persName>Brown</persName>, <persName>Gaywood</persName>, <persName>Grant</persName>, <persName>Heath</persName>, <persName>Louis</persName>, <persName ref="namedentities.xml#mr_pl">Platt</persName>, <persName>Powers</persName>, <persName>Sarjant</persName>,<lb/>
               Mesdames <persName>Bologna</persName>, <persName>I. Bologna</persName>, <persName>Cox</persName>, <persName>Heath</persName>, <persName>Louis</persName>, <persName>Ryall</persName>, <persName>Standen</persName>, <persName>Watts</persName>.<lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina</hi>.<lb/>
               The Grand Dramatick Romance of <hi rend="allcaps">Blue Beard</hi>; or, <hi rend="smallcaps">Female Curisoity</hi>,<lb/>
               continuing to be recieved throughout with universal applause, will be repeated every<lb/>
               Evening till further notice.</ab>
         </div>
      </body>
