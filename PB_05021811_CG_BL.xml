         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="smallcaps">New Theatre Royal, Covent-Garden,</hi></placeName><lb/>
               This present <hi rend="allcaps">Thursday</hi>, <date when="1811-05-02">May 2, 1811</date>, will be acted (6th time) the new Comedy of<lb/>
               <bibl><title ref="namedentities.xml#play_gazette_extraordinary">The <hi rend="allcaps">Gazette Extraordinary</hi></title></bibl><lb/>
               <castList>
                  <head><hi rend="italic">The principal Characters by</hi></head><lb/>
                  <castItem><actor ref="namedentities.xml#mr_young">Mr. <hi rend="allcaps">Young</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_jones">Mr. <hi rend="allcaps">Jones</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#jo_sh_mu">Mr. <hi rend="allcaps">Munden</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#ch_mu">Mr. <hi rend="allcaps">Murray</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_hamerton">Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_bishop">Mr. <hi rend="allcaps">Bishop</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mrs_weston">Mrs. <hi rend="allcaps">Weston</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#na_jo">Mrs. <hi rend="allcaps">H. Johnston</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#miss_bolton">Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#ma_an_da">Mrs. <hi rend="allcaps">Davenport</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#sa_bo">Miss <hi rend="allcaps">S. Booth</hi>,</actor></castItem><lb/>
               </castList>
               The <hi rend="allcaps">Prologue</hi> and <hi rend="allcaps">Epilogue</hi> to be spoken by <persName ref="namedentities.xml#mr_brunton">Mr. <hi rend="allcaps">Brunton</hi></persName> and <persName ref="namedentities.xml#sa_bo">Miss <hi rend="allcaps">S. Booth.</hi></persName><lb/>
               After which will be performed, <hi rend="italic">for the fourth time</hi>, a <hi rend="allcaps">Romantick Melo-Drama</hi>, called<lb/>
               <bibl><title ref="namedentities.xml#play_timour_the_tartar">Timour, the Tartar</title></bibl><lb/>
               <hi rend="italic">With entirely new Musick, Scenes, Machinery, Dresses and Decorations.</hi><lb/>
               <hi rend="italic">The <hi rend="allcaps">Overture</hi> and <hi rend="allcaps">Musick</hi> composed by <persName ref="namedentities.xml#ma_pe_ki"><hi rend="allcaps">M.P. King</hi></persName>.</hi>
               <hi rend="italic">The Scenes painted by Mess. <persName ref="namedentities.xml#th_ph_scenes">Phillips</persName>, <persName ref="namedentities.xml#ch_jo_pu">Pugh</persName>, <persName ref="namedentities.xml#jo_he_gr">Grieve</persName>, <persName ref="namedentities.xml#j_ho">Hollogan</persName>, <persName ref="namedentities.xml#mr_ho">Hodgins</persName>, &amp; their assistants</hi>.<lb/>
               The whole arranged under the Direction of <persName ref="namedentities.xml#ch_fa"><hi rend="italic">Mr</hi>. <hi rend="allcaps">Farley</hi></persName>.<lb/>
               <castList>
                  <head><hi rend="italic">The principal characters by</hi></head><lb/>
                  <castItem><actor ref="namedentities.xml#ch_fa">Mr. <hi rend="allcaps">Farley</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_chapman">Master <hi rend="allcaps">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_treby">Mr. <hi rend="allcaps">Treby</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_jefferies">Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_field">Mr. <hi rend="allcaps">Field</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_bishop">Mr. <hi rend="allcaps">Bishop</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_crossman">Mr. <hi rend="allcaps">Crossman</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_makeen">Mr. <hi rend="allcaps">Makeen</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_davies">Mr. <hi rend="allcaps">Davies</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#miss_bolton">Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#na_jo">Mrs. <hi rend="allcaps">H. Johnston</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Tartars</hi>,</role><lb/>
                     Mess. <actor ref="namedentities.xml#mr_banks">Banks,</actor> <actor ref="namedentities.xml#mr_blyth">Blyth,</actor> <actor ref="namedentities.xml#mr_brown">Brown,</actor> <actor ref="namedentities.xml#mr_edgecomb">Edgecomb,</actor> <actor ref="namedentities.xml#mr_gaywood">Gaywood,</actor> <actor ref="namedentities.xml#mr_goodwin">Goodwin,</actor> <actor ref="namedentities.xml#mr_grant">Grant,</actor> <actor ref="namedentities.xml#mr_griffiths">Griffiths,</actor> <actor ref="namedentities.xml#mr_heath">Heath,</actor><lb/>
                     <actor ref="namedentities.xml#mr_jeffkins">Jeffkins,</actor> <actor ref="namedentities.xml#mr_jeffries">Jeffries,</actor> <actor ref="namedentities.xml#mr_louis">Louis,</actor> <actor ref="namedentities.xml#mr_macdonald">Macdonald,</actor> <actor ref="namedentities.xml#mr_powers">Powers,</actor> <actor ref="namedentities.xml#mr_sarjant">Sarjant,</actor> <actor ref="namedentities.xml#mr_sibley">Sibley,</actor> <actor ref="namedentities.xml#mr_thurston">Thurston,</actor> <actor ref="namedentities.xml#mr_tolfer">Tolfer,</actor> &amp;c.<lb/>
                     Mesds. <actor ref="namedentities.xml#mrs_bologna">Bologna,</actor> <actor ref="namedentities.xml#mrs_i_bologna">I. Bologna,</actor> <actor ref="namedentities.xml#mrs_cox">Cox,</actor> <actor ref="namedentities.xml#mrs_heath">Heath,</actor> <actor ref="namedentities.xml#mrs_louis">Louis,</actor> <actor ref="namedentities.xml#mrs_ryall">Ryall,</actor> <actor ref="namedentities.xml#mrs_standen">Standen,</actor> <actor ref="namedentities.xml#mrs_watts">Watts,</actor> &amp;c.</castItem><lb/>
                  <castItem><hi rend="allcaps">Georgians,</hi><lb/>
                     Mess. <actor ref="namedentities.xml#mr_andrews">Andrews,</actor> <actor ref="namedentities.xml#mr_bath">Bath,</actor> <actor ref="namedentities.xml#mr_cooper">Cooper,</actor> <actor ref="namedentities.xml#mr_cordell">Cordell,</actor> <actor ref="namedentities.xml#mr_w_davies">W. Davies,</actor> <actor ref="namedentities.xml#mr_h_davies">H. Davies,</actor> <actor ref="namedentities.xml#mr_fagan">Fagan,</actor> <actor ref="namedentities.xml#mr_hall">Hall,</actor> <actor ref="namedentities.xml#mr_harris">Harris,</actor> <actor ref="namedentities.xml#mr_hodson">Hodson,</actor><lb/>
                     <actor ref="namedentities.xml#mr_holford">Holford,</actor> <actor ref="namedentities.xml#mr_kelly">Kelly,</actor> <actor ref="namedentities.xml#mr_lane">Lane,</actor> <actor ref="namedentities.xml#mr_paul">Paul,</actor> <actor ref="namedentities.xml#mr_phillimore">Phillimore,</actor> <actor ref="namedentities.xml#he_sm">Smith,</actor> <actor ref="namedentities.xml#mr_tate">Tate,</actor> <actor ref="namedentities.xml#mr_turpin">Turpin,</actor> <actor ref="namedentities.xml#mr_williams">Williams,</actor> <actor ref="namedentities.xml#mr_wright">Wright,</actor> &amp;c.</castItem><lb/>
               </castList>
               <hi rend="italic">The Machinery by <persName ref="namedentities.xml#mr_saul">Mr. Saul</persName>. The Decorations by <persName ref="namedentities.xml#mr_bradwell">Mr. Bradwell</persName></hi>.<lb/>
               The Dresses by <persName ref="namedentities.xml#mr_flowers">Mr. Flowers</persName> and <persName ref="namedentities.xml#miss_egan">Miss Egan</persName>.<lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina.</hi></ab>
         </div>
