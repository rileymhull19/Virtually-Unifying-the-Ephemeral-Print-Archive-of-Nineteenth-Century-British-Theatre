         <div type="performance_playbill" rend="align(center)">
            <ab><placeName ref="namedentities.xml#covent_garden"><hi rend="allcaps">New Theatre Royal, Covent-Garden.</hi></placeName><lb/>
               This present <hi rend="allcaps">Wednesday</hi>, <date rend="1811-02-20">Feb. 20, 1811</date>.<lb/>
               Will be performed (<hi rend="italic">11th time</hi>) a <hi rend="allcaps">New Musical Drama</hi>, in three acts, called The<lb/>
               <bibl><title ref="namedentities.xml#play_knight_of_snowdoun"><hi rend="allcaps">Knight</hi> of <hi rend="allcaps">Snowdoun</hi>.</title></bibl><lb/>
               <hi rend="italic">The <hi rend="allcaps">Overture</hi> and <hi rend="allcaps">Musick</hi> composed by <persName ref="namedentities.xml#he_ro_bi">Mr. <hi rend="allcaps">H.R. Bishop</hi></persName>.</hi><lb/>
               <castList>
                  <head><hi rend="italic">The principal Characters by</hi></head>
                  <castItem><actor ref="namedentities.xml#ch_ke">Mr. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_young">Mr. <hi rend="allcaps">Young</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#mr_chapman">Master <hi rend="allcaps">Chapman</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#da_eg">Mr. <hi rend="allcaps">Egerton</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#wi_bl">Mr. <hi rend="allcaps">Blanchard</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#jo_em">Mr. <hi rend="allcaps">Emery</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_truman">Mr. <hi rend="allcaps">Truman</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_droset">Master <hi rend="allcaps">Droset</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#th_lu_be">Mr. <hi rend="allcaps">Bellamy</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_hamerton">Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem><lb/>
                  <castItem><actor ref="namedentities.xml#sa_bo">Miss <hi rend="allcaps">S. Booth</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#ma_di">Mrs. <hi rend="allcaps">Dickons</hi>,</actor></castItem> <castItem><actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
               </castList>
               To which will be added, <hi rend="italic">for the third time</hi>, the <hi rend="allcaps">Grand Dramatick Romance</hi> of<lb/>
               <bibl><title type="main" ref="namedentities.xml#play_blue_beard"><hi rend="allcaps">Blue Beard;</hi></title><lb/>
                  <title type="sub"><hi rend="italic">Or,Female Curiosity.</hi></title></bibl><lb/>
               <hi rend="italic">With entirely new Scenes, Machinery, Dresses and Decorations.</hi><lb/>
               <hi rend="italic">The Musick composed and selected by <persName ref="namedentities.xml#mi_ke">Mr. <hi rend="allcaps">Kelly</hi></persName>.</hi><lb/>
               <castList>
                  <castItem><role>Abomelique,</role> <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>Ibrahim,</role> <actor ref="namedentities.xml#sa_si">Mr. <hi rend="allcaps">Simmons</hi>,</actor></castItem> <castItem><role>Selim,</role> <actor ref="namedentities.xml#mr_taylor">Mr. <hi rend="allcaps">Taylor</hi>,</actor></castItem><lb/>
                  <castItem><role>Shacabac,</role> <actor ref="namedentities.xml#jo_fa">Mr. <hi rend="allcaps">Fawcett</hi>,</actor></castItem><lb/>
                  <castItem><role>Hassan,</role> <actor ref="namedentities.xml#fr_me">Mr. <hi rend="allcaps">Menage</hi>,</actor></castItem><lb/>
                  <castItem><role>Fatima,</role> <actor ref="namedentities.xml#miss_bolton">Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>Irene,</role> <actor ref="namedentities.xml#ma_th_ke">Mrs. <hi rend="allcaps">C. Kemble</hi>,</actor></castItem><lb/>
                  <castItem><role>Beda,</role> <actor ref="namedentities.xml#sa_li">Mrs. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="italic"><hi rend="allcaps">Spahis</hi></hi>,</role><lb/>
                     Mess. <actor ref="namedentities.xml#mr_treby">Treby,</actor> <actor ref="namedentities.xml#mr_king">King,</actor> <actor ref="namedentities.xml#mr_bishop">Bishop,</actor> <actor ref="namedentities.xml#mr_hickman">Hickman,</actor> <actor ref="namedentities.xml#mr_droset">Droset,</actor> <actor ref="namedentities.xml#mr_norris">Norris,</actor> <actor ref="namedentities.xml#mr_tinney">Tinney,</actor> <actor ref="namedentities.xml#mr_crossman">Crossman,</actor><lb/>
                     <actor ref="namedentities.xml#mr_davies">Davies,</actor> <actor ref="namedentities.xml#mr_makeen">Makeen,</actor> <actor ref="namedentities.xml#mr_p_taylor">P. Taylor,</actor> &amp;c. &amp;c.<lb/></castItem>
                  <castItem><role><hi rend="allcaps"><hi rend="italic">Janizaries</hi></hi>,</role><lb/>
                     Mess. <actor ref="namedentities.xml#mr_i_bellamy">I. Bellamy,</actor> <actor ref="namedentities.xml#mr_bond">Bond,</actor> <actor ref="namedentities.xml#mr_dixon">Dixon,</actor> <actor ref="namedentities.xml#mr_everard">Everard,</actor> <actor ref="namedentities.xml#mr_fairclough">Fairclough,</actor> <actor ref="namedentities.xml#mr_lee">Lee,</actor> <actor ref="namedentities.xml#mr_linton">Linton,</actor> <actor ref="namedentities.xml#mr_montague">Montague,</actor> <actor ref="namedentities.xml#jo_no">Norman,</actor> <actor ref="namedentities.xml#ja_st">Street</actor><lb/>
                     <actor ref="namedentities.xml#mr_taylor">Taylor,</actor> <actor ref="namedentities.xml#mr_terry">Terry,</actor> <actor ref="namedentities.xml#jo_te">Tett,</actor> <actor ref="namedentities.xml#mr_williams">Williams,</actor></castItem>
                  <castItem><role><hi rend="allcaps"><hi rend="allcaps">Peasants</hi></hi>,</role><lb/>
                     Mesdames <actor ref="namedentities.xml#el_co">Coates,</actor> <actor ref="namedentities.xml#mrs_findlay">Findlay,</actor> <actor ref="namedentities.xml#mrs_grimaldi">Grimaldi,</actor> <actor ref="namedentities.xml#mrs_hardy">Hardy,</actor> <actor ref="namedentities.xml#mrs_iliff">Iliff,</actor> <actor ref="namedentities.xml#mrs_johnson">Johnson,</actor> <actor ref="namedentities.xml#mrs_price">Price,</actor> <actor ref="namedentities.xml#h_wh">Whitmore</actor>,<lb/></castItem>
               </castList>
               <hi rend="italic">The Dances by</hi><lb/>
               <persName ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi></persName>,<lb/>
               Mess. <persName ref="namedentities.xml#mr_brown">Brown</persName>, <persName ref="namedentities.xml#mr_gaywood">Gaywood</persName>, <persName ref="namedentities.xml#mr_grant">Grant</persName>, <persName ref="namedentities.xml#mr_heath">Heath</persName>, <persName ref="namedentities.xml#mr_louis">Louis</persName>, <persName ref="namedentities.xml#mr_pl">Platt</persName>, <persName ref="namedentities.xml#mr_powers">Powers</persName>, <persName ref="namedentities.xml#mr_sarjant">Sarjant</persName>,<lb/>
               Mesdames <persName ref="namedentities.xml#mrs_bologna">Bologna</persName>, <persName ref="namedentities.xml#mrs_i_bologna">I. Bologna</persName>, <persName ref="namedentities.xml#mrs_cox">Cox</persName>, <persName ref="namedentities.xml#mrs_heath">Heath</persName>, <persName ref="namedentities.xml#mrs_louis">Louis</persName>, <persName ref="namedentities.xml#rs_ryall">Ryall</persName>, <persName ref="namedentities.xml#mrs_standen">Standen</persName>, <persName ref="namedentities.xml#mrs_watts">Watts</persName>.<lb/>
               Scenes painted by <hi rend="italic">Mess. <persName ref="namedentities.xml#th_ph_scenes">Phillips</persName>, <persName ref="namedentities.xml#sa_wh">Whitmore</persName>, <persName ref="namedentities.xml#ch_jo_pu">Pugh</persName>, <persName ref="namedentities.xml#jo_he_gr">Grieve</persName>, <persName ref="namedentities.xml#j_ho">Hollogan</persName>, <persName ref="namedentities.xml#mr_ho">Hodgins</persName>,</hi> &amp; their assistants<lb/>
               <hi rend="italic">The Machinery by Mess. <persName ref="namedentities.xml#mr_saul">Saul</persName> and <persName ref="namedentities.xml#mr_bradwell">Bradwell</persName>. The Decorations by <persName ref="namedentities.xml#mr_bradwell">Mr. Bradwell</persName>.</hi><lb/>
               <hi rend="italic">The Dresses by <persName ref="namedentities.xml#mr_flowers">Mr. Flowers</persName> and <persName ref="namedentities.xml#miss_egan">Miss Egan</persName>.</hi><lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina.</hi></ab>
         </div>
