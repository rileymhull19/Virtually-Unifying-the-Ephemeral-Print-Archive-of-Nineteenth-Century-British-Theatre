  <text>
      <body>
         <div type="performance_playbill" rend="align(center)">
            <ab><hi rend="allcaps">Acted</hi> but <hi rend="allcaps">Twice</hi>.<lb/>
               <placeName ref="namedentities.xml#covent_garden"><hi rend="allcaps">Theatre Royal, Covent Garden,</hi></placeName><lb/>
               This present <date when="1812-02-03"><hi rend="allcaps">Monday</hi>, Feb. 3, 1812</date>,<lb/>
               Will be performed a new Grand <hi rend="italic">Operatick Drama</hi>, in three acts, called The<lb/>
               <bibl><title ref="namedentities.xml#play_virgin_of_the_sun">Virgin of the Sun.</title></bibl><lb/>
               [Founded on the <hi rend="smallcaps">Incas</hi> of <hi rend="italic">Marmontel</hi>, and <hi rend="italic">Kotzebue</hi>'s Play of <hi rend="smallcaps">Rolla</hi>: or, <hi rend="italic">the Virgin of the Sun</hi>]<lb/>
               <hi rend="italic">With entirely new Musick, Scenery, Dresses and Decorations.</hi><lb/>
               <hi rend="italic">The <hi rend="allcaps">Overture</hi> and <hi rend="allcaps">Musick</hi> composed by <persName ref="namedentities.xml#he_ro_bi">Mr. <hi rend="allcaps">H.R. Bishop</hi></persName>.</hi><lb/>
               <hi rend="italic">The <hi rend="smallcaps">Scenery</hi> painted by Mess. <persName ref="namedentities.xml#th_ph_scenes">Phillips</persName>, <persName ref="namedentities.xml#sa_wh">Whitmore</persName>, <persName ref="namedentities.xml#j_ho">Hollogan</persName>, and <persName ref="namedentities.xml#ch_jo_pu">Pugh</persName>.</hi><lb/>
               The <hi rend="allcaps">Machinery</hi> and <hi rend="allcaps">Decorations</hi> by <hi rend="italic">Mess. <persName ref="namedentities.xml#mr_saul">Saul</persName> and <persName ref="namedentities.xml#mr_bradwell">Bradwell</persName></hi>.<lb/>
               The Dresses by <persName ref="namedentities.xml#mr_flowers">Mr. Flowers</persName> and <persName ref="namedentities.xml#miss_egan">Miss Egan</persName>.<lb/>
               <castList>
                  <head><hi rend="italic">Principal Characters.</hi></head>
                  <castItem><role>Ataliba</role> by <actor ref="namedentities.xml#mr_barrymore">Mr. <hi rend="allcaps">Barrymore</hi>,</actor></castItem><lb/>
                  <castItem><role>The High Priest</role> by <actor ref="namedentities.xml#da_eg">Mr. <hi rend="allcaps">Egerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Xaira</role> by <actor ref="namedentities.xml#mr_creswell">Mr. <hi rend="allcaps">Creswell</hi>,</actor></castItem><lb/>
                  <castItem><role>Telasko</role> by <actor ref="namedentities.xml#mr_chapman">Mr. <hi rend="allcaps">Chapman</hi>,</actor></castItem><lb/>
                  <castItem><role>Don Alonzo</role> by <actor ref="namedentities.xml#mr_huntley">Mr. <hi rend="allcaps">Huntley</hi>,</actor></castItem><lb/>
                  <castItem><role>Don Velasquez</role> by <actor ref="namedentities.xml#mr_brunton">Mr. <hi rend="allcaps">Brunton</hi>,</actor></castItem><lb/>
                  <castItem><role>Rolla</role> by <actor ref="namedentities.xml#mr_young">Mr. <hi rend="allcaps">Young</hi>,</actor></castItem><lb/>
                  <castItem><role>Cualpo</role> by <actor ref="namedentities.xml#mr_hamerton">Mr. <hi rend="allcaps">Hamerton</hi>,</actor></castItem><lb/>
                  <castItem><role>Zamor</role> by <actor ref="namedentities.xml#mr_sinclair">Mr. <hi rend="allcaps">Sinclair</hi>,</actor></castItem><lb/>
                  <castItem><role>Diego</role> by <actor ref="namedentities.xml#jo_li">Mr. <hi rend="allcaps">Liston</hi>,</actor></castItem><lb/>
                  <castItem><role>Ozmar</role> by <actor ref="namedentities.xml#mr_broadhurst">Mr. <hi rend="allcaps">Broadhurst</hi>,</actor></castItem> <castItem><role>Tupac</role> by <actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem><lb/>
                  <castItem><role>The High Priestess</role> by <actor ref="namedentities.xml#ja_po">Mrs. <hi rend="allcaps">Powell</hi>,</actor></castItem><lb/>
                  <castItem><role>Cora</role> by <actor ref="namedentities.xml#miss_smith">Miss <hi rend="allcaps">Smith</hi>,</actor></castItem><lb/>
                  <castItem><role>Amazili</role> by <actor ref="namedentities.xml#miss_feron">Miss <hi rend="allcaps">Feron</hi>,</actor></castItem><lb/>
                  <castItem><role>Idali</role> by <actor ref="namedentities.xml#miss_bolton">Miss <hi rend="allcaps">Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>Zilia</role> by <actor ref="namedentities.xml#mrs_childe">Mrs. <hi rend="allcaps">Childe</hi>,</actor></castItem><lb/>
                  <castItem><role>Runa</role> by <actor ref="namedentities.xml#miss_e_bolton">Miss <hi rend="allcaps">E. Bolton</hi>.</actor></castItem><lb/>
                  <castItem><role><hi rend="italic">High Priests, Virgins of the Sun, Warriors, &amp;c.</hi></role><lb/>
                     Mess. <actor ref="namedentities.xml#mr_bishop">Bishop,</actor> <actor ref="namedentities.xml#mr_duruset">Duruset,</actor> <actor ref="namedentities.xml#mr_everard">Everard,</actor> <actor ref="namedentities.xml#mr_hickman">Hickman,</actor> <actor ref="namedentities.xml#mr_huckel">Huckel,</actor> <actor ref="namedentities.xml#mr_lee">Lee,</actor> <actor ref="namedentities.xml#mr_linton">Linton,</actor> <actor ref="namedentities.xml#mr_montague">Montague,</actor> <actor ref="namedentities.xml#mr_norris">Norris,</actor> <actor ref="namedentities.xml#ja_st">Street,</actor> <actor ref="namedentities.xml#mr_j_taylor">J. Taylor</actor><lb/>
                     <actor ref="namedentities.xml#mr_terry">Terry,</actor> <actor ref="namedentities.xml#jo_te">Tett,</actor> <actor ref="namedentities.xml#mr_s_tett">S. Tett,</actor> <actor ref="namedentities.xml#mr_tinney">Tinney,</actor> <actor ref="namedentities.xml#mr_williams">Williams</actor><lb/>
                     Mess. <actor ref="namedentities.xml#mr_brown">Brown,</actor> <actor ref="namedentities.xml#mr_grant">Grant,</actor> <actor ref="namedentities.xml#mr_heath">Heath,</actor> <actor ref="namedentities.xml#mr_louis">Louis,</actor> <actor ref="namedentities.xml#mr_pl">Platt,</actor> <actor ref="namedentities.xml#mr_powers">Powers,</actor> <actor ref="namedentities.xml#mr_sarjant">Sarjant,</actor> <actor ref="namedentities.xml#mr_yarnold">Yarnold</actor><lb/>
                     Mesdames <actor ref="namedentities.xml#mrs_bologna">Bologna,</actor> <actor ref="namedentities.xml#mrs_i_bologna">I. Bologna,</actor> <actor ref="namedentities.xml#miss_carew">Carew,</actor> <actor ref="namedentities.xml#el_co">Coates,</actor> <actor ref="namedentities.xml#mrs_cox">Cox,</actor> <actor ref="namedentities.xml#mrs_emery">Emery,</actor> <actor ref="namedentities.xml#mrs_findlay">Findlay,</actor> <actor ref="namedentities.xml#mrs_grimaldi">Grimaldi,</actor> <actor ref="namedentities.xml#mrs_hardy">Hardy,</actor> <actor ref="namedentities.xml#mrs_heath">Heath</actor><lb/>
                     <actor ref="namedentities.xml#mrs_iliff">Iliff,</actor> <actor ref="namedentities.xml#mrs_johnson">Johnson,</actor> <actor ref="namedentities.xml#mrs_kniveton">Kniveton,</actor> <actor ref="namedentities.xml#mrs_logan">Logan,</actor> <actor ref="namedentities.xml#mrs_louis">Louis,</actor> <actor ref="namedentities.xml#mrs_price">Price,</actor> <actor ref="namedentities.xml#mrs_ryall">Ryall,</actor> <actor ref="namedentities.xml#mrs_standen">Standen,</actor> <actor ref="namedentities.xml#mrs_watts">Watts,</actor> <actor ref="namedentities.xml#h_wh">Whitmore.</actor></castItem><lb/>
               </castList>
               <hi rend="italic">Books of the Songs to be had in the Theatre, price <measure type="currency">1s</measure>.</hi><lb/>
               After which will be performed, <hi rend="italic">for the 32d time, a <hi rend="allcaps">New Pantomime</hi>, called</hi><lb/>
               <bibl><title type="main" ref="namedentities.xml#play_harlequin_and_padmanaba">Harlequin &amp; Padmanaba</title><lb/>
                  <title type="sub"><hi rend="allcaps">Or</hi><lb/>
                     <hi rend="allcaps">The Golden Fish.</hi></title></bibl><lb/>
               <castList>
                  <castItem><role><hi rend="allcaps">Padmanaba</hi> (a renowned Astrologer</role> <actor ref="namedentities.xml#mr_jefferies">Mr. <hi rend="allcaps">Jefferies</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Sultan</hi> of <hi rend="allcaps">Chashmire</hi>, (afterwards Pantaloon)</role> <actor ref="namedentities.xml#jo_no">Mr. <hi rend="allcaps">Norman</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Omar</hi>, the Fisherman, (afterwards Harlequin)</role> <actor ref="namedentities.xml#jo_pe_bo">Mr. <hi rend="allcaps">Bologna,</hi> Jun.</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Cayfacttadhre</hi>, the Persian Cook, (afterwards Clown)</role> <actor ref="namedentities.xml#jo_gr">Mr. <hi rend="allcaps">Grimaldi</hi>,</actor></castItem><lb/>
                  <castItem><role>Grand Vizier,</role> <actor ref="namedentities.xml#mr_how">Mr. <hi rend="allcaps">Howell</hi>,</actor></castItem> <castItem><role>Nekir <hi rend="italic">(the Black Evil Spirit)</hi></role> <actor ref="namedentities.xml#mr_king">Mr. <hi rend="allcaps">King</hi>,</actor></castItem><lb/>
                  <castItem><role>Zadig, the old Fisherman,</role> <actor ref="namedentities.xml#mr_tinney">Mr. <hi rend="allcaps">Tinney</hi>,</actor></castItem> <castItem><role>Selim, his son,</role> <actor ref="namedentities.xml#mr_broadhurst">Mr. <hi rend="allcaps">Broadhurst</hi>,</actor></castItem><lb/>
                  <castItem><role><hi rend="allcaps">Zelica</hi>, the Sultan's Daughter, (afterwards Colombine)</role> <actor ref="namedentities.xml#so_pa">Mrs. <hi rend="allcaps">Parker</hi>,</actor></castItem><lb/>
                  <castItem><role>Morea, the Fisherman's Daughter,</role> <actor ref="namedentities.xml#miss_e_bolton">Miss <hi rend="allcaps">E. Bolton</hi>,</actor></castItem><lb/>
                  <castItem><role>The Fairy Cheheristany,</role> <actor ref="namedentities.xml#miss_worgman">Miss <hi rend="allcaps">Worgman</hi>,</actor></castItem><lb/>
               </castList>
               <hi rend="italic">No <hi rend="allcaps">Orders</hi> can possibly be admitted.</hi><lb/>
               <hi rend="allcaps">Vivant Rex &amp; Regina.</hi><lb/>
               The new Operatick Drama called The <hi rend="allcaps">Virgin</hi> of the <hi rend="allcaps">Sun</hi>,<lb/>
               having been again recieved throughout with the highest approbation and applause, will be repeated<lb/>
               every Evening till further notice, with<lb/>
               The new Pantomime of <hi rend="allcaps">Harlequin &amp; Padmanaba</hi>; or, The Golden Fish.</ab>
         </div>
